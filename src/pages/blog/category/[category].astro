---
import TextPostItem from "../../../components/blog/TextPostItem.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getBlogs } from "../../../lib/api";
import { slugify } from "../../../lib/utils"; 

// Tidak perlu getStaticPaths() lagi
export const prerender = false;



const categoryHref = (category?: string | null) =>
  category ? `/blog/category/${slugify(category)}` : "/blog";


const { category } = Astro.params;

const blogsResponse = await getBlogs();
const blogs = blogsResponse.data ?? [];
const publishedBlogs = blogs.filter((blog) => blog.is_published);

const categoryBlogs = publishedBlogs.filter(
  (blog) => slugify(blog.category) === slugify(category)
);


if (categoryBlogs.length === 0) {
  return Astro.redirect("/blog");
}

const allCategories = [
  ...new Set(
    publishedBlogs
      .map((blog) => blog.category)
      .filter((cat): cat is string => Boolean(cat))
  ),
];

const seen = new Set<string>();
const otherCategories = allCategories.filter((item) => {
  const slug = slugify(item);
  if (slug === slugify(category) || seen.has(slug)) return false;
  seen.add(slug);
  return true;
});

const categoryLabel =
  categoryBlogs[0]?.category ?? category;
---

<BaseLayout
  title={`${categoryLabel} Blog`}
  description={`Kumpulan artikel seputar ${categoryLabel} dari Zeni Consulting.`}
  noPadding
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero__bg"></div>
    <div class="container page-hero__inner">
      <span
        class="page-hero__badge"
        data-aos="fade-up"
        data-i18n="blog.hero.badge">Insights</span
      >
      <h1 data-aos="fade-up" data-i18n="blog.hero.title">Blog</h1>
      <p class="page-hero__sub" data-aos="fade-up" data-i18n="blog.hero.sub">
        Insights on technology, strategy, and building systems that scale.
      </p>
    </div>
  </section>

  <section class="category-page">
    <section class="category-hero">
      <div class="container category-hero__inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog">Blog</a>
          <span aria-hidden="true">/</span>
          <span>{categoryLabel}</span>
        </nav>

        <div class="category-hero__content">
          <div>
            <span class="category-eyebrow">Topic library</span>
            <h1>{categoryLabel}</h1>
            <p>
              Kumpulan insight pilihan seputar {categoryLabel} untuk membantu tim
              bisnis dan teknologi mengambil keputusan yang lebih rapi.
            </p>
          </div>

          <div class="category-summary" aria-label="Ringkasan kategori">
            <span>{categoryBlogs.length}</span>
            <p>Artikel tersedia</p>
          </div>
        </div>
      </div>
    </section>

    <section class="category-section">
      <div class="container">
        <div class="category-toolbar">
          <a href="/blog" class="back-link">Kembali ke Blog</a>

          <div class="category-pills" aria-label="Kategori lainnya">
            {
              otherCategories.slice(0, 6).map((item) => (
                <a href={categoryHref(item)}>{item}</a>
              ))
            }
          </div>
        </div>

        <div class="category-grid">
          {categoryBlogs.map((blog) => <TextPostItem blog={blog} />)}
        </div>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  /* Page hero */
  .page-hero {
    position: relative;
    padding: calc(4rem + var(--space-3xl)) 0 var(--space-3xl);
    overflow: hidden;
    background:
      linear-gradient(
        135deg,
        var(--color-primary) 0%,
        var(--color-primary-dark) 58%,
        var(--color-primary-darker) 100%
      );
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.85), transparent);
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 44rem;
  }

  .page-hero__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    margin-bottom: var(--space-lg);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .page-hero h1 {
    margin-bottom: var(--space-md);
    color: var(--color-white);
    font-size: 3.25rem;
    letter-spacing: 0;
  }

  .page-hero__sub {
    max-width: 38rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  /* Category page */
  .category-page {
    --category-ink: #102033;
    --category-muted: #5d6b7c;
    --category-border: #dce6f0;
    --category-soft: #f5f9fd;
    --category-shadow: 0 18px 42px rgba(16, 32, 51, 0.08);

    background:
      linear-gradient(
        180deg,
        var(--color-white) 0%,
        var(--category-soft) 44%,
        var(--color-white) 100%
      );
    color: var(--category-ink);
    font-family: var(--font-body);
  }

  .category-page a {
    text-decoration: none;
  }

  .category-hero {
    padding: 52px 0 44px;
    background:
      linear-gradient(180deg, var(--color-white) 0%, rgba(240, 247, 255, 0.92) 100%);
  }

  .category-hero__inner {
    display: grid;
    gap: 24px;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--category-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .breadcrumb a {
    color: var(--category-muted);
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .breadcrumb span {
    color: #a7b5c4;
  }

  .breadcrumb span:last-child {
    color: var(--category-ink);
    font-weight: 700;
  }

  .category-hero__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px;
    gap: 32px;
    align-items: end;
  }

  .category-eyebrow {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    padding: 0.4rem 0.7rem;
    border: 1px solid rgba(0, 96, 175, 0.14);
    border-radius: var(--radius-full);
    background: var(--color-primary-50);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1;
  }

  .category-hero h1 {
    max-width: 820px;
    margin: 18px 0 0;
    color: var(--category-ink);
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .category-hero p {
    max-width: 720px;
    margin: 18px 0 0;
    color: #4d5f75;
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .category-summary {
    display: grid;
    gap: 6px;
    padding: 22px;
    border: 1px solid rgba(0, 96, 175, 0.12);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: var(--category-shadow);
  }

  .category-summary span {
    color: var(--color-primary);
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
  }

  .category-summary p {
    margin: 0;
    color: var(--category-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .category-section {
    padding: 46px 0 92px;
  }

  .category-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  .back-link,
  .category-pills a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0 0.875rem;
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 800;
    line-height: 1;
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .back-link {
    border: 1px solid rgba(0, 96, 175, 0.18);
    background: var(--color-primary);
    color: var(--color-white);
    white-space: nowrap;
  }

  .back-link:hover {
    transform: translateY(-1px);
    background: var(--color-primary-dark);
    color: var(--color-white);
  }

  .category-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .category-pills a {
    border: 1px solid rgba(0, 96, 175, 0.14);
    background: var(--color-white);
    color: var(--color-primary);
  }

  .category-pills a:hover {
    border-color: rgba(0, 96, 175, 0.28);
    background: var(--color-primary-50);
    color: var(--color-primary-dark);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: stretch;
  }

  @media (prefers-reduced-motion: reduce) {
    .breadcrumb a,
    .back-link,
    .category-pills a {
      transition: none;
    }
  }

  @media (max-width: 980px) {
    .category-hero__content {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .category-summary {
      width: min(100%, 260px);
    }

    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .page-hero {
      padding: calc(4rem + var(--space-2xl)) 0 var(--space-2xl);
    }

    .page-hero h1 {
      font-size: 2.625rem;
    }

    .category-hero {
      padding: 44px 0 36px;
    }

    .category-section {
      padding: 40px 0 72px;
    }

    .category-toolbar {
      align-items: flex-start;
      flex-direction: column;
    }

    .category-pills {
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    .page-hero h1 {
      font-size: 2.25rem;
    }

    .page-hero__sub,
    .category-hero p {
      font-size: 1rem;
    }

    .breadcrumb {
      font-size: 0.8125rem;
    }

    .category-hero h1 {
      font-size: 2.125rem;
    }

    .category-summary {
      width: 100%;
      padding: 18px;
    }

    .category-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
