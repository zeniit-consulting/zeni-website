---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatCategory } from "../../lib/formatCategory";
import { getBlogs } from "../../lib/api";

const blogsResponse = await getBlogs();
const blogs = blogsResponse.data ?? [];

const publishedBlogs = blogs.filter((blog) => blog.is_published);

const heroBlog = publishedBlogs[0] ?? null;
const popularBlogs = publishedBlogs.slice(1, 5);
const latestBlogs = publishedBlogs.slice(0, 9);
const businessBlogs = publishedBlogs.slice(1, 7);
const professionalBlogs = publishedBlogs.slice(2, 5);
const professionalFeatured = publishedBlogs[0] ?? null;
const middleBusinessBlog = businessBlogs[3] ?? null;

const highlightedCategories = publishedBlogs.filter(
  (blog, index, self) =>
    blog.category &&
    index === self.findIndex((item) => item.category === blog.category),
);

const slugify = (value: string) =>
  value
    .toLowerCase()
    .trim()
    .replace(/&/g, "and")
    .replace(/\s+/g, "-")
    .replace(/[^a-z0-9-]/g, "");

const categoryHref = (category?: string | null) =>
  category ? `/blog/category/${slugify(category)}` : "/blog";

const formatDate = (dateString?: string | null) => {
  if (!dateString) return "Draft";

  return new Date(dateString).toLocaleDateString("id-ID", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
};


---

<BaseLayout
  title="Blog"
  description="Thought leadership and insights from Zeni Consulting on technology, strategy, and scaling systems."
  noPadding
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero__bg"></div>
    <div class="container page-hero__inner">
      <span
        class="page-hero__badge"
        data-aos="fade-up"
        data-i18n="blog.hero.badge">Insights</span
      >
      <h1 data-aos="fade-up" data-i18n="blog.hero.title">Blog</h1>
      <p class="page-hero__sub" data-aos="fade-up" data-i18n="blog.hero.sub">
        Insights on technology, strategy, and building systems that scale.
      </p>
    </div>
  </section>

  <!-- Blogs -->
  <section class="blog-page">
    <section class="blog-main-section">
      <div class="container blog-main-grid">
        <div class="left-content">
          {
            heroBlog && (
              <article class="hero-blog-card">
                <a
                  href={`/blog/${heroBlog.slug}`}
                  class="hero-blog-card__media"
                  aria-label={`Baca ${heroBlog.title}`}
                >
                  <img
                    src={heroBlog.thumbnail_url}
                    alt={heroBlog.title}
                    loading="lazy"
                  />
                </a>
                <div class="hero-blog-content">
                  <a
                    class="blog-category blog-category--inverse"
                    href={categoryHref(heroBlog.category)}
                  >
                    {formatCategory(heroBlog.category)}
                  </a>

                  <a
                    href={`/blog/${heroBlog.slug}`}
                    class="hero-blog-title-link"
                  >
                    <h2>{heroBlog.title}</h2>
                  </a>
                  <p class="hero-blog-excerpt">{heroBlog.excerpt}</p>

                  <div class="blog-meta blog-meta--inverse">
                    <span>
                      {heroBlog.published_at
                        ? formatDate(heroBlog.published_at)
                        : "Draft"}
                    </span>
                    {heroBlog.read_time && (
                      <span>{heroBlog.read_time} min read</span>
                    )}
                    {heroBlog.author && <span>{heroBlog.author}</span>}
                  </div>
                </div>
              </article>
            )
          }

          <div class="section-heading">
            <span>Curated reads</span>
            <h2>Paling banyak dibaca</h2>
          </div>

          <div class="popular-list">
            {
              popularBlogs.map((blog) => (
                <article class="popular-item">
                  <a
                    href={`/blog/${blog.slug}`}
                    class="popular-item__media"
                    aria-label={`Baca ${blog.title}`}
                  >
                    <img
                      src={blog.thumbnail_url}
                      alt={blog.title}
                      loading="lazy"
                    />
                  </a>
                  <div class="popular-item__content">
                    {blog.category && (
                      <a
                        class="blog-category"
                        href={categoryHref(blog.category)}
                      >
                        {formatCategory(blog.category)}
                      </a>
                    )}
                    <a href={`/blog/${blog.slug}`} class="post-title-link">
                      <h3>{blog.title}</h3>
                    </a>
                    <p class="post-excerpt">{blog.excerpt}</p>
                    <div class="blog-meta">
                      <span>
                        {blog.published_at
                          ? formatDate(blog.published_at)
                          : "Draft"}
                      </span>
                      <span>
                        {blog.read_time ? `${blog.read_time} min read` : ""}
                      </span>
                      <span>{blog.author}</span>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>

          <div class="subscribe-strip">
            <div>
              <span>Newsletter</span>
              <p>
                Dapatkan akses eksklusif ke konten pilihan seputar bisnis dan
                karier profesional.
              </p>
            </div>
            <a href="#">Subscribe sekarang</a>
          </div>

          <section class="explore-section">
            <div class="section-heading">
              <span>Business playbook</span>
              <h2>Eksplor Bisnis</h2>
            </div>

            <div class="explore-grid">
              <div class="small-list">
                {
                  businessBlogs.slice(0, 3).map((blog) => (
                    <article class="text-post">
                      {blog.category && (
                        <a
                          class="blog-category"
                          href={categoryHref(blog.category)}
                        >
                          {blog.category}
                        </a>
                      )}
                      <a href={`/blog/${blog.slug}`} class="post-title-link">
                        <h3>{blog.title}</h3>
                      </a>
                      <div class="blog-meta">
                        <span>
                          {blog.published_at
                            ? formatDate(blog.published_at)
                            : "Draft"}
                        </span>
                        <span>
                          {blog.read_time ? `${blog.read_time} min read` : ""}
                        </span>
                        <span>{blog.author}</span>
                      </div>
                    </article>
                  ))
                }
              </div>

              {
                middleBusinessBlog && (
                  <article class="middle-feature">
                    <a
                      href={`/blog/${middleBusinessBlog.slug}`}
                      class="middle-feature__media"
                      aria-label={`Baca ${middleBusinessBlog.title}`}
                    >
                      {middleBusinessBlog.thumbnail_url && (
                        <img
                          src={middleBusinessBlog.thumbnail_url}
                          alt={middleBusinessBlog.title}
                          loading="lazy"
                        />
                      )}
                    </a>

                    {middleBusinessBlog.category && (
                      <a
                        class="blog-category"
                        href={categoryHref(middleBusinessBlog.category)}
                      >
                        {middleBusinessBlog.category}
                      </a>
                    )}

                    <a
                      href={`/blog/${middleBusinessBlog.slug}`}
                      class="post-title-link"
                    >
                      <h3>{middleBusinessBlog.title}</h3>
                    </a>

                    {middleBusinessBlog.excerpt && (
                      <p class="post-excerpt">{middleBusinessBlog.excerpt}</p>
                    )}

                    <div class="blog-meta">
                      <span>
                        {middleBusinessBlog.published_at
                          ? formatDate(middleBusinessBlog.published_at)
                          : "Draft"}
                      </span>

                      {middleBusinessBlog.read_time && (
                        <span>{middleBusinessBlog.read_time} min read</span>
                      )}

                      {middleBusinessBlog.author && (
                        <span>{middleBusinessBlog.author}</span>
                      )}
                    </div>
                  </article>
                )
              }

              <div class="small-list">
                {
                  businessBlogs.slice(3, 6).map((blog) => (
                    <article class="text-post">
                      {blog.category && (
                        <a
                          class="blog-category"
                          href={categoryHref(blog.category)}
                        >
                          {blog.category}
                        </a>
                      )}
                      <a href={`/blog/${blog.slug}`} class="post-title-link">
                        <h3>{blog.title}</h3>
                      </a>
                      <div class="blog-meta">
                        <span>
                          {blog.published_at
                            ? formatDate(blog.published_at)
                            : "Draft"}
                        </span>
                        <span>
                          {blog.read_time ? `${blog.read_time} min read` : ""}
                        </span>
                        <span>{blog.author}</span>
                      </div>
                    </article>
                  ))
                }
              </div>
            </div>
          </section>
        </div>

        <aside class="latest-sidebar" aria-label="Artikel terbaru">
          <div class="latest-sidebar__header">
            <span>Fresh insights</span>
            <h2>Terbaru</h2>
          </div>

          <div class="latest-list">
            {
              latestBlogs.map((blog) => (
                <article class="latest-item">
                  {blog.category && (
                    <a class="blog-category" href={categoryHref(blog.category)}>
                      {formatCategory(blog.category)}
                    </a>
                  )}
                  <a href={`/blog/${blog.slug}`} class="post-title-link">
                    <h3>{blog.title}</h3>
                  </a>
                  <div class="blog-meta">
                    <span>
                      {blog.published_at
                        ? formatDate(blog.published_at)
                        : "Draft"}
                    </span>
                    <span>
                      {blog.read_time ? `${blog.read_time} min read` : ""}
                    </span>
                    <span>{blog.author}</span>
                  </div>
                </article>
              ))
            }
          </div>
        </aside>
      </div>
    </section>

    <section class="highlight-section">
      <div class="container">
        <div class="section-heading section-heading--on-dark">
          <span>Topic lanes</span>
          <h2>Artikel sorotan</h2>
        </div>

        <div class="highlight-marquee" aria-label="Kategori artikel">
          <div class="highlight-track">
            {
              [...highlightedCategories, ...highlightedCategories].map(
                (blog) => (
                  <article class="highlight-card">
                    <a
                      href={categoryHref(blog.category)}
                      aria-label={`Lihat kategori ${blog.category}`}
                    >
                      <img
                        src={blog.thumbnail_url}
                        alt={blog.category}
                        loading="lazy"
                      />
                      <div>
                        <span>{blog.category}</span>
                      </div>
                    </a>
                  </article>
                ),
              )
            }
          </div>
        </div>
      </div>
    </section>

    <section class="professional-section">
      <div class="container professional-grid">
        <div class="professional-list">
          <div class="section-heading">
            <span>Professional growth</span>
            <h2>Eksplor Profesional</h2>
          </div>

          {
            professionalBlogs.map((blog) => (
              <article class="text-post">
                {blog.category && (
                  <a class="blog-category" href={categoryHref(blog.category)}>
                    {formatCategory(blog.category)}
                  </a>
                )}
                <a href={`/blog/${blog.slug}`} class="post-title-link">
                  <h3>{blog.title}</h3>
                </a>
                <div class="blog-meta">
                  <span>
                    {blog.published_at
                      ? formatDate(blog.published_at)
                      : "Draft"}
                  </span>
                  <span>
                    {blog.read_time ? `${blog.read_time} min read` : ""}
                  </span>
                  <span>{blog.author}</span>
                </div>
              </article>
            ))
          }
        </div>

        {
          professionalFeatured && (
            <article class="professional-feature">
              <a
                href={`/blog/${professionalFeatured.slug}`}
                class="professional-feature__media"
                aria-label={`Baca ${professionalFeatured.title}`}
              >
                {professionalFeatured.thumbnail_url && (
                  <img
                    src={professionalFeatured.thumbnail_url}
                    alt={professionalFeatured.title}
                    loading="lazy"
                  />
                )}
              </a>

              <div>
                {professionalFeatured.category && (
                  <a
                    class="blog-category"
                    href={categoryHref(professionalFeatured.category)}
                  >
                    {formatCategory(professionalFeatured.category)}
                  </a>
                )}

                <a
                  href={`/blog/${professionalFeatured.slug}`}
                  class="post-title-link"
                >
                  <h3>{professionalFeatured.title}</h3>
                </a>

                {professionalFeatured.excerpt && (
                  <p class="post-excerpt">{professionalFeatured.excerpt}</p>
                )}

                <div class="blog-meta">
                  <span>{formatDate(professionalFeatured.published_at)}</span>

                  {professionalFeatured.read_time && (
                    <span>{professionalFeatured.read_time} min read</span>
                  )}

                  {professionalFeatured.author && (
                    <span>{professionalFeatured.author}</span>
                  )}
                </div>
              </div>
            </article>
          )
        }

        <div class="subscribe-card">
          <div class="subscribe-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path
                d="M4 6.5h16v11H4v-11Z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"></path>
              <path
                d="m5 7.5 7 5 7-5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3>Dapatkan kurasi artikel terbaru dari Zeni Consulting</h3>
          <a href="#">Subscribe sekarang</a>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  /* Page hero */
  .page-hero {
    position: relative;
    padding: calc(4rem + var(--space-3xl)) 0 var(--space-3xl);
    overflow: hidden;
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-primary-dark) 58%,
      var(--color-primary-darker) 100%
    );
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    background-thumbnail_url:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-thumbnail_url: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.85),
      transparent
    );
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 44rem;
  }

  .page-hero__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    margin-bottom: var(--space-lg);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .page-hero h1 {
    margin-bottom: var(--space-md);
    color: var(--color-white);
    font-size: 3.25rem;
    letter-spacing: 0;
  }

  .page-hero__sub {
    max-width: 38rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  /* Blog page */
  .blog-page {
    --blog-ink: #102033;
    --blog-muted: #5d6b7c;
    --blog-border: #dce6f0;
    --blog-soft: #f5f9fd;
    --blog-shadow: 0 18px 42px rgba(16, 32, 51, 0.08);

    background: linear-gradient(
      180deg,
      var(--color-white) 0%,
      var(--blog-soft) 45%,
      var(--color-white) 100%
    );
    color: var(--blog-ink);
    font-family: var(--font-body);
  }

  .blog-page :global(a) {
    text-decoration: none;
  }

  .blog-page h2,
  .blog-page h3 {
    color: var(--blog-ink);
    letter-spacing: 0;
  }

  .blog-main-section {
    padding: 56px 0 64px;
  }

  .blog-main-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 40px;
    align-items: start;
  }

  .left-content {
    min-width: 0;
  }

  .section-heading {
    margin: 36px 0 18px;
  }

  .section-heading span,
  .latest-sidebar__header span,
  .subscribe-strip span {
    display: inline-flex;
    margin-bottom: 8px;
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .section-heading h2,
  .latest-sidebar__header h2 {
    margin: 0;
    font-size: 1.625rem;
    line-height: 1.25;
  }

  .section-heading--on-dark h2 {
    color: var(--color-white);
  }

  .section-heading--on-dark span {
    color: rgba(255, 255, 255, 0.72);
  }

  .blog-category {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    padding: 0.35rem 0.625rem;
    border: 1px solid rgba(0, 96, 175, 0.14);
    border-radius: var(--radius-full);
    background: var(--color-primary-50);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1;
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .blog-category:hover {
    border-color: rgba(0, 96, 175, 0.28);
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
  }

  .blog-category--inverse {
    border-color: rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.14);
    color: var(--color-white);
  }

  .blog-category--inverse:hover {
    border-color: rgba(255, 255, 255, 0.36);
    background: rgba(255, 255, 255, 0.2);
    color: var(--color-white);
  }

  .blog-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    color: var(--blog-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .blog-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .blog-meta span:not(:first-child)::before {
    width: 4px;
    height: 4px;
    border-radius: var(--radius-full);
    background: #b7c4d1;
    content: "";
  }

  .blog-meta--inverse {
    color: rgba(255, 255, 255, 0.82);
  }

  .blog-meta--inverse span:not(:first-child)::before {
    background: rgba(255, 255, 255, 0.48);
  }

  .post-title-link h3,
  .hero-blog-title-link h2 {
    transition: color var(--transition-fast);
  }

  .post-title-link:hover h3,
  .hero-blog-title-link:hover h2 {
    color: var(--color-primary);
  }

  .post-excerpt {
    color: var(--blog-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .hero-blog-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.9fr);
    overflow: hidden;
    border: 1px solid rgba(0, 96, 175, 0.14);
    border-radius: var(--radius-md);
    background: var(--color-primary);
    box-shadow: var(--blog-shadow);
  }

  .hero-blog-card__media {
    order: 2;
    min-height: 100%;
    overflow: hidden;
  }

  .hero-blog-card__media img {
    width: 100%;
    height: 100%;
    min-height: 360px;
    display: block;
    object-fit: cover;
  }

  .hero-blog-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    padding: 44px;
  }

  .hero-blog-title-link h2 {
    margin: 0;
    color: var(--color-white);
    font-size: 2rem;
    line-height: 1.28;
  }

  .hero-blog-title-link:hover h2 {
    color: rgba(255, 255, 255, 0.86);
  }

  .hero-blog-excerpt {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .popular-list {
    display: grid;
    gap: 16px;
  }

  .popular-item {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 20px;
    padding: 14px;
    border: 1px solid var(--blog-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    transition:
      transform var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .popular-item:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 96, 175, 0.22);
    box-shadow: 0 18px 36px rgba(16, 32, 51, 0.08);
  }

  .popular-item__media {
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-neutral-100);
  }

  .popular-item__media img {
    width: 100%;
    height: 100%;
    min-height: 150px;
    display: block;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .popular-item:hover .popular-item__media img,
  .middle-feature:hover img,
  .professional-feature:hover img,
  .highlight-card:hover img {
    transform: scale(1.04);
  }

  .popular-item__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 4px 4px 4px 0;
  }

  .popular-item h3,
  .latest-item h3,
  .text-post h3 {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.42;
  }

  .popular-item .post-excerpt {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .latest-sidebar {
    position: sticky;
    top: 88px;
    padding: 24px;
    border: 1px solid var(--blog-border);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: var(--shadow-sm);
  }

  .latest-sidebar__header {
    margin-bottom: 8px;
  }

  .latest-list {
    display: grid;
  }

  .latest-item {
    display: grid;
    gap: 10px;
    padding: 18px 0;
    border-top: 1px solid var(--blog-border);
  }

  .latest-item:first-child {
    border-top: 0;
  }

  .latest-item h3 {
    font-size: 0.98rem;
  }

  .subscribe-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 28px 0 6px;
    padding: 22px 24px;
    border: 1px solid rgba(0, 96, 175, 0.14);
    border-radius: var(--radius-md);
    background: linear-gradient(
      90deg,
      var(--color-primary-50),
      var(--color-white)
    );
  }

  .subscribe-strip p {
    max-width: 38rem;
    margin: 0;
    color: var(--blog-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .subscribe-strip a,
  .subscribe-card a {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 1rem;
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-white);
    font-size: 0.875rem;
    font-weight: 800;
    transition:
      transform var(--transition-fast),
      background var(--transition-fast),
      box-shadow var(--transition-fast);
    white-space: nowrap;
