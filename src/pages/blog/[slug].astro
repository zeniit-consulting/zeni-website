---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getBlogs } from "../../lib/api";
import { slugify } from "../../lib/utils";
import { formatCategory } from "../../lib/formatCategory";

// SSR — data selalu fresh dari API
export const prerender = false;


const categoryHref = (category?: string | null) =>
  category ? `/blog/category/${slugify(category)}` : "/blog";

const formatDate = (dateString?: string | null) => {
  if (!dateString) return "Draft";
  return new Date(dateString).toLocaleDateString("id-ID", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
};

// Ambil slug dari URL
const { slug } = Astro.params;

const blogsResponse = await getBlogs();
const allBlogs = blogsResponse.data ?? [];
const publishedBlogs = allBlogs.filter((b) => b.is_published);

// Cari blog berdasarkan slug
const blog = publishedBlogs.find((b) => b.slug === slug);

// Kalau tidak ditemukan → redirect
if (!blog) {
  return Astro.redirect("/blog");
}

// Related blogs — same category dulu
const relatedByCategory = publishedBlogs
  .filter(
    (item) =>
      item.slug !== blog.slug &&
      slugify(item.category) === slugify(blog.category)
  )
  .slice(0, 3);

// Fallback kalau kategori sama tidak cukup
const relatedFallback = publishedBlogs
  .filter((item) => item.slug !== blog.slug)
  .slice(0, 3);

const finalRelatedBlogs =
  relatedByCategory.length > 0 ? relatedByCategory : relatedFallback;
---

<BaseLayout title={blog.title} description={blog.excerpt ?? ""} noPadding>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero__bg"></div>
    <div class="container page-hero__inner">
      <span
        class="page-hero__badge"
        data-aos="fade-up"
        data-i18n="blog.hero.badge">Insights</span
      >
      <h1 data-aos="fade-up" data-i18n="blog.hero.title">Blog</h1>
      <p class="page-hero__sub" data-aos="fade-up" data-i18n="blog.hero.sub">
        Insights on technology, strategy, and building systems that scale.
      </p>
    </div>
  </section>

  <section class="blog-detail-page">
    <div class="detail-hero">
      <div class="container detail-container">

        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog">Blog</a>
          <span aria-hidden="true">/</span>
          {
            blog.category && (
              <a href={categoryHref(blog.category)}>
               {formatCategory(blog.category)}
              </a>
            )
          }
         
          
        </nav>

        <!-- Category Badge -->
        {
          blog.category && (
            <a href={categoryHref(blog.category)} class="detail-category">
             {formatCategory(blog.category)}
            </a>
          )
        }

        <h1>{blog.title}</h1>
        <p class="detail-excerpt">{blog.excerpt}</p>

        <!-- Meta -->
        <div class="meta" aria-label="Article metadata">
          {blog.author && (
            <span><strong>Penulis</strong> {blog.author}</span>
          )}
          <span>
            <strong>Tanggal</strong>
            {blog.published_at ? formatDate(blog.published_at) : "Draft"}
          </span>
          {blog.read_time && (
            <span><strong>Durasi</strong> {blog.read_time} min read</span>
          )}
        </div>

        <!-- Thumbnail -->
        {
          blog.thumbnail_url && (
            <div class="hero-image-wrap">
              <img
                src={blog.thumbnail_url}
                alt={blog.title}
                class="hero-image"
                loading="eager"
              />
            </div>
          )
        }
      </div>
    </div>

    <div class="detail-content-section">
      <div class="container article-layout">

        <!-- Article Content -->
        <article class="article-content">
          {
            blog.excerpt && (
              <div class="lead-block">
                <span>Ringkasan</span>
                <p class="lead">{blog.excerpt}</p>
              </div>
            )
          }

          <!-- ✅ Render HTML content langsung dari API -->
          {
  blog.content && (
    <div class="content-body" set:html={blog.content} />
  )
}
        </article>

        <!-- Related Sidebar -->
        <aside class="related-sidebar">
          <div class="related-sidebar__header">
            <span>Baca selanjutnya</span>
            <h2>Artikel terkait</h2>
          </div>

          {
            finalRelatedBlogs.length > 0 ? (
              finalRelatedBlogs.map((item) => (
                <article class="related-card">
                  <a
                    href={`/blog/${item.slug}`}
                    class="related-card__media"
                    aria-label={`Baca ${item.title}`}
                  >
                    {item.thumbnail_url && (
                      <img
                        src={item.thumbnail_url}
                        alt={item.title}
                        loading="lazy"
                      />
                    )}
                  </a>
                  <div class="related-card__content">
                    {item.category && (
                      <a
                        class="related-card__category"
                        href={categoryHref(item.category)}
                      >
                       {formatCategory(item.category)}
                      </a>
                    )}
                    <h3>
                      <a href={`/blog/${item.slug}`}>{item.title}</a>
                    </h3>
                    <p>
                      <span>
                        {item.published_at
                          ? formatDate(item.published_at)
                          : "Draft"}
                      </span>
                      {item.read_time && (
                        <span>{item.read_time} min read</span>
                      )}
                    </p>
                  </div>
                </article>
              ))
            ) : (
              <p class="no-related">Belum ada artikel terkait.</p>
            )
          }
        </aside>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Page hero */
  .page-hero {
    position: relative;
    padding: calc(4rem + var(--space-3xl)) 0 var(--space-3xl);
    overflow: hidden;
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-primary-dark) 58%,
      var(--color-primary-darker) 100%
    );
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.85), transparent);
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 44rem;
  }

  .page-hero__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    margin-bottom: var(--space-lg);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .page-hero h1 {
    margin-bottom: var(--space-md);
    color: var(--color-white);
    font-size: 3.25rem;
    letter-spacing: 0;
  }

  .page-hero__sub {
    max-width: 38rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  /* Blog detail */
  .blog-detail-page {
    --article-ink: #102033;
    --article-muted: #5d6b7c;
    --article-border: #dce6f0;
    --article-soft: #f5f9fd;
    --article-shadow: 0 18px 42px rgba(16, 32, 51, 0.08);

    background: linear-gradient(
      180deg,
      var(--color-white) 0%,
      var(--article-soft) 42%,
      var(--color-white) 100%
    );
    color: var(--article-ink);
    font-family: var(--font-body);
  }

  .blog-detail-page a {
    text-decoration: none;
  }

  .detail-hero {
    padding: 56px 0 46px;
    background: linear-gradient(
      180deg,
      var(--color-white) 0%,
      rgba(240, 247, 255, 0.88) 100%
    );
  }

  .detail-container {
    max-width: 980px;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 24px;
    color: var(--article-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .breadcrumb a {
    color: var(--article-muted);
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .breadcrumb span {
    color: #a7b5c4;
  }

  .category-pill,
  .related-card__category {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    padding: 0.4rem 0.7rem;
    border: 1px solid rgba(0, 96, 175, 0.14);
    border-radius: var(--radius-full);
    background: var(--color-primary-50);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1;
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .category-pill:hover,
  .related-card__category:hover {
    border-color: rgba(0, 96, 175, 0.28);
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
  }

  .detail-hero h1 {
    max-width: 900px;
    margin: 18px 0 0;
    color: var(--article-ink);
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .detail-excerpt {
    max-width: 760px;
    margin: 20px 0 0;
    color: #4d5f75;
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 28px;
  }

  .meta span {
    display: grid;
    gap: 4px;
    min-width: 0;
    padding: 14px 16px;
    border: 1px solid rgba(0, 96, 175, 0.12);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.78);
    color: var(--article-ink);
    box-shadow: var(--shadow-sm);
  }

  .meta strong {
    color: var(--article-muted);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .hero-image-wrap {
    overflow: hidden;
    margin-top: 34px;
    padding: 8px;
    border: 1px solid rgba(0, 96, 175, 0.12);
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: var(--article-shadow);
  }

  .hero-image {
    width: 100%;
    height: 500px;
    display: block;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .detail-content-section {
    padding: 52px 0 96px;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 760px) 330px;
    justify-content: center;
    gap: 48px;
    align-items: start;
  }

  .article-content {
    display: grid;
    gap: 34px;
    min-width: 0;
    padding: 36px;
    border: 1px solid var(--article-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  .lead-block {
    padding: 22px;
    border: 1px solid rgba(0, 96, 175, 0.12);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    background: linear-gradient(
      90deg,
      var(--color-primary-50),
      var(--color-white)
    );
  }

  .lead-block span,
  .related-sidebar__header span {
    display: inline-flex;
    margin-bottom: 8px;
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .article-content .lead {
    margin: 0;
    color: #344054;
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .content-block h2 {
    margin: 0 0 14px;
    color: var(--article-ink);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.25;
    letter-spacing: 0;
  }

  .content-block p,
  .content-block li {
    color: #536173;
    font-size: 1rem;
    line-height: 1.85;
  }

  .content-block p + p {
    margin-top: 16px;
  }

  .content-block ul {
    display: grid;
    gap: 12px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .content-block li {
    position: relative;
    padding-left: 28px;
  }

  .content-block li::before {
    position: absolute;
    top: 0.72em;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    box-shadow: 0 0 0 5px rgba(0, 96, 175, 0.1);
    content: "";
  }

  .related-sidebar {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 16px;
    min-width: 0;
  }

  .related-sidebar__header h2 {
    margin: 0;
    color: var(--article-ink);
    font-size: 1.375rem;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .related-card {
    display: grid;
    gap: 13px;
    padding: 12px;
    border: 1px solid var(--article-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .related-card:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 96, 175, 0.22);
    box-shadow: 0 18px 36px rgba(16, 32, 51, 0.08);
  }

  .related-card__media {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-neutral-100);
  }

  .related-card__media img {
    width: 100%;
    height: 148px;
    display: block;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .related-card:hover .related-card__media img {
    transform: scale(1.04);
  }

  .related-card__content {
    display: grid;
    gap: 10px;
    align-items: start;
  }

  .related-card h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: 0;
  }

  .related-card h3 a {
    color: var(--article-ink);
    transition: color var(--transition-fast);
  }

  .related-card h3 a:hover {
    color: var(--color-primary);
  }

  .related-card p {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    color: var(--article-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .related-card p span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .related-card p span:not(:first-child)::before {
    width: 4px;
    height: 4px;
    border-radius: var(--radius-full);
    background: #b7c4d1;
    content: "";
  }

  

  .content-body {
    color: #374151;
    line-height: 1.75;
    font-size: 1rem;
  }

  .content-body h1,
  .content-body h2,
  .content-body h3,
  .content-body h4 {
    font-weight: 700;
    color: #111827;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .content-body h1 { font-size: 2rem; }
  .content-body h2 { font-size: 1.5rem; }
  .content-body h3 { font-size: 1.25rem; }
  .content-body h4 { font-size: 1.1rem; }

  .content-body p {
    margin-bottom: 1rem;
  }

  .content-body ul,
  .content-body ol {
    margin: 1rem 0 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .content-body ul { list-style: disc; }
  .content-body ol { list-style: decimal; }

  .content-body li {
    line-height: 1.7;
  }

  .content-body strong {
    font-weight: 700;
    color: #111827;
  }

  .content-body em {
    font-style: italic;
  }

  .content-body a {
    color: #2563eb;
    text-decoration: underline;
  }

  .content-body a:hover {
    color: #1d4ed8;
  }

  .content-body blockquote {
    border-left: 4px solid #e5e7eb;
    padding: 0.5rem 0 0.5rem 1rem;
    margin: 1.5rem 0;
    color: #6b7280;
    font-style: italic;
    background: #f9fafb;
    border-radius: 0 0.25rem 0.25rem 0;
  }

  .content-body img {
    max-width: 100%;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }

  .content-body hr {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 2rem 0;
  }

  .content-body pre {
    background: #1f2937;
    color: #f9fafb;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .content-body code {
    background: #f3f4f6;
    color: #ef4444;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }

  .content-body pre code {
    background: transparent;
    color: inherit;
    padding: 0;
  }


  @media (prefers-reduced-motion: reduce) {
    .breadcrumb a,
    .category-pill,
    .related-card,
    .related-card__category,
    .related-card__media img,
    .related-card h3 a {
      transition: none;
    }
  }

  @media (max-width: 1040px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .related-sidebar {
      position: static;
    }
  }

  @media (max-width: 860px) {
    .page-hero {
      padding: calc(4rem + var(--space-2xl)) 0 var(--space-2xl);
    }

    .page-hero h1 {
      font-size: 2.625rem;
    }

    .detail-hero {
      padding: 44px 0 36px;
    }

    .hero-image {
      height: 360px;
    }

    .detail-content-section {
      padding: 40px 0 72px;
    }

    .article-content {
      padding: 28px;
    }
  }

  @media (max-width: 640px) {
    .page-hero h1 {
      font-size: 2.25rem;
    }

    .page-hero__sub,
    .detail-excerpt,
    .article-content .lead {
      font-size: 1rem;
    }

    .breadcrumb {
      margin-bottom: 18px;
      font-size: 0.8125rem;
    }

    .detail-hero h1 {
      font-size: 2.125rem;
    }

    .meta {
      grid-template-columns: 1fr;
    }

    .hero-image-wrap {
      margin-top: 26px;
      padding: 6px;
    }

    .hero-image {
      height: 260px;
    }

    .article-content {
      gap: 28px;
      padding: 22px;
    }

    .lead-block {
      padding: 18px;
    }

    .content-block h2 {
      font-size: 1.375rem;
    }

    .content-block p,
    .content-block li {
      font-size: 0.96rem;
    }
  }
</style>
