---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceDetail from "../../components/ServiceDetail.astro";
import ServiceSidebar from "../../components/ServiceSidebar.astro";
import { projects } from "../../data/projects";
import { t } from "../../scripts/i18n";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const lang = Astro.currentLocale || "en";
---

<BaseLayout
  title="Projects"
  description="Showcasing our work: real-world projects that demonstrate our expertise in web development, design, and digital solutions. See how we solve problems and create value for our clients."
  noPadding
>
  <section class="svc-hero">
    <div class="svc-hero__bg"></div>
    <div class="container svc-hero__inner">
      <a
        href="/projects"
        class="svc-hero__back"
        data-i18n="projects.detail.back">&larr; All Projects</a
      >
      <h1 data-i18n={`project.${project.key}.title`}></h1>
      <p class="svc-hero__sub" data-i18n={`project.${project.key}.description`}>
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container container--narrow">
      <div class="service-layout">
        <!-- left -->
        <div class="project-main">
          <div class="project-image">
            <img
              src={project.image}
              alt={t(`project.${project.key}.title`)}
              loading="lazy"
            />
          </div>
          <div class="project-content">
            <span
              class="project-badge"
              data-i18n={`project.${project.key}.tech`}></span>
            <h2 data-i18n={`project.${project.key}.title`}></h2>
            <p data-i18n={`project.${project.key}.description`}></p>
          </div>
        </div>
        <!-- RIGHT -->
        <ServiceSidebar />
      </div>
    </div>
  </section>

  <!-- Process Overview -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section__label" data-i18n="services.process.label"
          >Our Process</span
        >
        <h2 class="section__title" data-i18n="services.process.title">
          How every engagement works
        </h2>
        <p class="section__subtitle" data-i18n="services.process.subtitle">
          Regardless of the service, our structured process ensures consistent,
          high-quality outcomes.
        </p>
      </div>
      <div class="process-row">
        <div class="process-item" data-aos="fade-up">
          <div class="process-item__number">1</div>
          <h3 data-i18n="services.process.step1.title">Discovery</h3>
          <p data-i18n="services.process.step1.text">
            We learn your business, goals, and constraints before proposing
            anything.
          </p>
        </div>
        <div class="process-item" data-aos="fade-up" data-aos-delay="100">
          <div class="process-item__number">2</div>
          <h3 data-i18n="services.process.step2.title">Plan</h3>
          <p data-i18n="services.process.step2.text">
            Clear scope, milestones, and timeline agreed before any work begins.
          </p>
        </div>
        <div class="process-item" data-aos="fade-up" data-aos-delay="200">
          <div class="process-item__number">3</div>
          <h3 data-i18n="services.process.step3.title">Execute</h3>
          <p data-i18n="services.process.step3.text">
            Transparent delivery with regular check-ins and progress reports.
          </p>
        </div>
        <div class="process-item" data-aos="fade-up" data-aos-delay="300">
          <div class="process-item__number">4</div>
          <h3 data-i18n="services.process.step4.title">Handover</h3>
          <p data-i18n="services.process.step4.text">
            Documentation, training, and knowledge transfer included in every
            engagement.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="services-cta">
    <div class="services-cta__bg"></div>
    <div class="container services-cta__inner" data-aos="fade-up">
      <h2 data-i18n="services.cta.title">Ready to discuss your project?</h2>
      <p data-i18n="services.cta.text">
        Every engagement starts with a conversation. Let's find the right
        solution for your business.
      </p>
      <a
        href="/contact"
        class="btn btn--white btn--large"
        data-i18n="services.cta.btn">Schedule a Consultation</a
      >
    </div>
  </section>
</BaseLayout>

<style>
  .section-header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }
  .svc-hero {
    position: relative;
    padding: calc(4rem + var(--space-3xl)) 0 var(--space-3xl);
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-primary-dark) 60%,
      var(--color-primary-darker) 100%
    );
    overflow: hidden;
  }
  .svc-hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 50% at 70% 30%,
      rgba(255, 255, 255, 0.06) 0%,
      transparent 60%
    );
    pointer-events: none;
  }
  .svc-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }
  .svc-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: var(--space-xl);
    transition: color var(--transition-fast);
  }
  .svc-hero__back:hover {
    color: var(--color-white);
  }
  .svc-hero__icon {
    width: 3.5rem;
    height: 3.5rem;
    background: rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    margin-bottom: var(--space-lg);
  }
  .svc-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }
  .svc-hero__sub {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin: 0;
  }
  @media (max-width: 768px) {
    .svc-hero {
      padding: calc(4rem + var(--space-2xl)) 0 var(--space-2xl);
    }
  }

  .service-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 40px;
  }

  /* === PROJECT MAIN === */

  .project-main {
    background-color: var(--color-white);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    transition: all 0.4s ease;
    cursor: pointer;
    position: relative;
    height: 100%;
  }
  .project-main:hover {
    transform: translateY(-5px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.12);
  }

  .project-image {
    overflow: hidden;
    position: relative;
  }
  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .project-main:hover .project-image img {
    transform: scale(1.05);
  }
  .project-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 50% at 70% 30%,
      rgba(255, 255, 255, 0.06) 0%,
      transparent 60%
    );
  }
  .project-content {
    padding: 28px;
  }

  .project-content h2 {
    font-size: 24px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 10px;
    font-family: "Poppins", sans-serif;
  }

  .project-content p {
    font-size: 15px;
    color: #6b7280;
    line-height: 1.6;
    font-family: "Inter", sans-serif;
  }

  .project-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 5px;
    width: 100%;
    background: linear-gradient(90deg, #2563eb, #06b6d4);
  }

  .project-badge {
    display: inline-block;
    padding: 6px 14px;
    background: #eff6ff;
    color: #2563eb;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 14px;
  }

  /* ═══ PROCESS ═══ */
  .process-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xl);
  }

  .process-item {
    text-align: center;
  }

  .process-item__number {
    width: 3rem;
    height: 3rem;
    background: var(--color-primary);
    color: var(--color-white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0 auto var(--space-md);
  }

  .process-item h3 {
    font-size: 1rem;
    margin-bottom: var(--space-sm);
    color: var(--color-neutral-900);
  }

  .process-item p {
    font-size: 0.875rem;
    color: var(--color-neutral-600);
    line-height: 1.6;
    margin: 0;
  }

  /* ═══ CTA ═══ */
  .services-cta {
    position: relative;
    padding: var(--space-5xl) 0;
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-primary-dark) 50%,
      var(--color-primary-darker) 100%
    );
    overflow: hidden;
  }

  .services-cta__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 60% at 30% 50%,
      rgba(255, 255, 255, 0.06) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .services-cta__inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .services-cta__inner h2 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .services-cta__inner p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.125rem;
    max-width: 32rem;
    margin: 0 auto var(--space-xl);
    line-height: 1.7;
  }

  /* ─── RESPONSIVE ─────────────────────────────────────────────── */

  @media (max-width: 768px) {
   
    .svc-hero {
      padding: calc(4rem + var(--space-2xl)) 0 var(--space-2xl);
    }
    .svc-hero__sub {
      font-size: 1rem;
    }

    
    .service-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    
    .process-row {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }

  
    .project-content h2 {
      font-size: 20px;
    }
    .project-content p {
      font-size: 14px;
    }
    .project-content {
      padding: 20px;
    }
  }

 
  @media (max-width: 480px) {
   
    .svc-hero {
      padding: calc(4rem + var(--space-xl)) 0 var(--space-xl);
    }
    .svc-hero__icon {
      width: 2.75rem;
      height: 2.75rem;
    }

    
    .process-row {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    
    .process-item__number {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1rem;
    }

   
    .project-content {
      padding: 16px;
    }
    .project-content h2 {
      font-size: 18px;
    }
    .project-badge {
      font-size: 12px;
      padding: 5px 11px;
    }

   
    .services-cta__inner p {
      font-size: 1rem;
    }
  }
</style>
