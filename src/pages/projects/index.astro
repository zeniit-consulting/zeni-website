---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getServices } from "../../lib/api";
import { formatTech } from "../../lib/formatTech";

const servicesResponse = await getServices();
const services = servicesResponse.data;
---

<BaseLayout
  title="Projects"
  description="Explore our portfolio of successful projects and see how we've helped businesses achieve their goals."
  noPadding
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero__bg"></div>
    <div class="container page-hero__inner">
      <span
        class="page-hero__badge"
        data-aos="fade-up"
        data-i18n="projects.hero.badge">What We Do</span
      >
      <h1 data-aos="fade-up" data-i18n="projects.hero.title">Our Projects</h1>
      <p
        class="page-hero__sub"
        data-aos="fade-up"
        data-i18n="projects.hero.sub"
      >
        Explore our portfolio of successful projects and see how we've helped
        businesses achieve their goals.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <!-- Project Showcase -->
  <section class="projects section insights-section">
    <div class="container">
      <div class="services-grid">
        {
          services.map((service) => (
            <a
              href={`/projects/${service.slug}`}
              class="project-card"
              data-aos="fade-up"
            >
              <div class="project-image">
                <img
                  src={service.image_url}
                  alt={`${service.title}`}
                  loading="lazy"
                />
              </div>
              <div class="project-content">
                {service.techs?.length ? (
                  <div class="project-tech-list">
                    {service.techs?.map((tech) => (
                      <span class="project-tech-pill">{formatTech(tech)}</span>
                    ))}
                  </div>
                ) : null}
                <h2 class="service-card__title">{service.title}</h2>
                <p class="service-card__text">{service.description}</p>
                <span
                  class="service-card__link"
                  data-i18n="project.viewdetails"
                >
                  View details &rarr;
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process Overview -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section__label" data-i18n="services.process.label"
          >Our Process</span
        >
        <h2 class="section__title" data-i18n="services.process.title">
          How every engagement works
        </h2>
        <p class="section__subtitle" data-i18n="services.process.subtitle">
          Regardless of the service, our structured process ensures consistent,
          high-quality outcomes.
        </p>
      </div>
      <div class="process-row">
        <div class="process-item" data-aos="fade-up">
          <div class="process-item__number">1</div>
          <h3 data-i18n="services.process.step1.title">Discovery</h3>
          <p data-i18n="services.process.step1.text">
            We learn your business, goals, and constraints before proposing
            anything.
          </p>
        </div>
        <div class="process-item" data-aos="fade-up" data-aos-delay="100">
          <div class="process-item__number">2</div>
          <h3 data-i18n="services.process.step2.title">Plan</h3>
          <p data-i18n="services.process.step2.text">
            Clear scope, milestones, and timeline agreed before any work begins.
          </p>
        </div>
        <div class="process-item" data-aos="fade-up" data-aos-delay="200">
          <div class="process-item__number">3</div>
          <h3 data-i18n="services.process.step3.title">Execute</h3>
          <p data-i18n="services.process.step3.text">
            Transparent delivery with regular check-ins and progress reports.
          </p>
        </div>
        <div class="process-item" data-aos="fade-up" data-aos-delay="300">
          <div class="process-item__number">4</div>
          <h3 data-i18n="services.process.step4.title">Handover</h3>
          <p data-i18n="services.process.step4.text">
            Documentation, training, and knowledge transfer included in every
            engagement.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="services-cta">
    <div class="services-cta__bg"></div>
    <div class="container services-cta__inner" data-aos="fade-up">
      <h2 data-i18n="services.cta.title">Ready to discuss your project?</h2>
      <p data-i18n="services.cta.text">
        Every engagement starts with a conversation. Let's find the right
        solution for your business.
      </p>
      <a
        href="/contact"
        class="btn btn--white btn--large"
        data-i18n="services.cta.btn">Schedule a Consultation</a
      >
    </div>
  </section>
</BaseLayout>

<style>
  /* ═══ PAGE HERO ═══ */
  .page-hero {
    position: relative;
    padding: calc(4rem + var(--space-3xl)) 0 var(--space-3xl);
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-primary-dark) 60%,
      var(--color-primary-darker) 100%
    );
    overflow: hidden;
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 50% at 70% 30%,
      rgba(255, 255, 255, 0.06) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  .page-hero__badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: var(--space-lg);
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .page-hero__sub {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin: 0;
  }

  /* ═══ SERVICES GRID ═══ */
  .projects .container {
    max-width: 83rem;
  }
  .section-header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .service-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-xl);
    background: var(--color-white);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-xl);
    transition: all var(--transition-base);
    text-decoration: none;
    color: inherit;
  }

  .service-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    color: inherit;
  }

  .service-card__icon {
    width: 3.5rem;
    height: 3.5rem;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-lg);
    transition: all var(--transition-base);
  }

  .service-card:hover .service-card__icon {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .service-card__title {
    font-size: 1.125rem;
    margin-bottom: var(--space-sm);
    color: var(--color-neutral-900);
  }

   .service-card__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .service-card__text {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .service-card__link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: 1rem;
  }

  /* ═══ PROCESS ═══ */
  .process-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xl);
  }

  .process-item {
    text-align: center;
  }

  .process-item__number {
    width: 3rem;
    height: 3rem;
    background: var(--color-primary);
    color: var(--color-white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0 auto var(--space-md);
  }

  .process-item h3 {
    font-size: 1rem;
    margin-bottom: var(--space-sm);
    color: var(--color-neutral-900);
  }

  .process-item p {
    font-size: 0.875rem;
    color: var(--color-neutral-600);
    line-height: 1.6;
    margin: 0;
  }

  /* ═══ CTA ═══ */
  .services-cta {
    position: relative;
    padding: var(--space-5xl) 0;
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-primary-dark) 50%,
      var(--color-primary-darker) 100%
    );
    overflow: hidden;
  }

  .services-cta__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 60% at 30% 50%,
      rgba(255, 255, 255, 0.06) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .services-cta__inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .services-cta__inner h2 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .services-cta__inner p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.125rem;
    max-width: 32rem;
    margin: 0 auto var(--space-xl);
    line-height: 1.7;
  }

  /* === PROJECTS GRID ===  */

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 35px;
    margin-top: 50px;
  }

  .project-card {
    background: #ffffff;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    transition: all 0.4s ease;
    cursor: pointer;
    position: relative;
  }

  .project-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15);
  }

  .project-image {
    overflow: hidden;
    height: 240px;
    position: relative;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .project-tech-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 20px;
  }

  

  .project-tech-pill {
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: #eef4ff;
    color: #2563eb;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
  }

  .project-card:hover .project-image img {
    transform: scale(1.08);
  }

  .project-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.15), transparent);
  }

  .project-content {
    padding: 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-content h3 {
    font-size: 24px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 10px;
    font-family: "Poppins", sans-serif;
  }

  .project-content p {
    font-size: 15px;
    color: #6b7280;
    line-height: 1.6;
    font-family: "Inter", sans-serif;
  }

  .project-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 5px;
    width: 100%;
    background: linear-gradient(90deg, #2563eb, #06b6d4);
  }
  .project-badge {
    display: inline-block;
    padding: 6px 14px;
    background: #eff6ff;
    color: #2563eb;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 14px;
  }

  .project-btn {
    display: inline-block;
    margin-top: 20px;
    text-decoration: none;
    color: #2563eb;
    font-weight: 600;
    transition: 0.3s;
  }

  .project-btn:hover {
    letter-spacing: 1px;
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-row {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-xl);
    }
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: calc(4rem + var(--space-2xl)) 0 var(--space-2xl);
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .process-row {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .services-cta {
      padding: var(--space-3xl) 0;
    }
  }
</style>
