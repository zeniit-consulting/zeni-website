---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";

const services = [
  {
    href: "/services/web-development",
    titleKey: "home.feature.web.title",
    textKey: "home.feature.web.text",
    delay: 0,
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><line x1="4" y1="10" x2="20" y2="10"/></svg>',
  },
  {
    href: "/services/mobile-development",
    titleKey: "home.feature.mobile.title",
    textKey: "home.feature.mobile.text",
    delay: 50,
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="2" width="14" height="20" rx="2"/><circle cx="12" cy="16" r="1"/></svg>',
  },
  {
    href: "/services/web-app-development",
    titleKey: "home.feature.webapp.title",
    textKey: "home.feature.webapp.text",
    delay: 100,
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="7" y1="4" x2="7" y2="20"/></svg>',
  },
  {
    href: "/services/development",
    titleKey: "home.feature.dev.title",
    textKey: "home.feature.dev.text",
    delay: 150,
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
  },
  {
    href: "/services/hardware",
    titleKey: "home.feature.hw.title",
    textKey: "home.feature.hw.text",
    delay: 200,
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>',
  },
  {
    href: "/services/consulting",
    titleKey: "home.feature.it.title",
    textKey: "home.feature.it.text",
    delay: 250,
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>',
  },
  {
    href: "/services/automation",
    titleKey: "home.feature.ai.title",
    textKey: "home.feature.ai.text",
    delay: 300,
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>',
  },
  {
    href: "/services/audit",
    titleKey: "home.feature.audit.title",
    textKey: "home.feature.audit.text",
    delay: 350,
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>',
  },
  {
    href: "/services/strategy",
    titleKey: "home.feature.strategy.title",
    textKey: "home.feature.strategy.text",
    delay: 400,
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
  },
];

const testimonials = [
  {
    quoteKey: "home.testimonial.1.text",
    nameKey: "home.testimonial.1.name",
    roleKey: "home.testimonial.1.role",
    initial: "A",
    delay: 0,
  },
  {
    quoteKey: "home.testimonial.2.text",
    nameKey: "home.testimonial.2.name",
    roleKey: "home.testimonial.2.role",
    initial: "S",
    delay: 100,
  },
  {
    quoteKey: "home.testimonial.3.text",
    nameKey: "home.testimonial.3.name",
    roleKey: "home.testimonial.3.role",
    initial: "B",
    delay: 200,
  },
];
---

<BaseLayout
  title="Home"
  description="Strategic IT consulting for growing businesses. Software development, hardware installation, IT consulting, and AI automation."
  noPadding
>
  <section class="hero">
    <div class="hero__bg"></div>
    <div class="container hero__grid">
      <div class="hero__content" data-aos="fade-up">
        <span class="hero__badge" data-i18n="home.hero.badge"
          >IT Consulting & Services</span
        >
        <h1 class="hero__headline" data-i18n="home.hero.headline">
          Build systems that scale with the technology you need.
        </h1>
        <p class="hero__sub" data-i18n="home.hero.sub">
          Strategic IT consulting for growing businesses. From software
          development to AI automation—we align technology with your goals.
        </p>
        <div class="hero__cta">
          <a
            href="/contact"
            class="btn btn--white btn--large"
            data-i18n="home.hero.cta1">Book Free Consultation</a
          >
          <a
            href="/services"
            class="btn btn--ghost btn--large"
            data-i18n="home.hero.cta2">View Services</a
          >
        </div>
      </div>

      <div class="hero__panel" data-aos="fade-left" data-aos-delay="150">
        <div class="hero-panel__aside">
          <div class="hero-mini-card">
            <span class="hero-mini-card__label" data-i18n="home.stat.projects"
              >Projects Delivered</span
            >
            <strong>50+</strong>
          </div>
          <div class="hero-mini-card">
            <span
              class="hero-mini-card__label"
              data-i18n="home.stat.satisfaction">Client Satisfaction</span
            >
            <strong>98%</strong>
          </div>
          <div class="hero-mini-card hero-mini-card--accent">
            <span class="hero-mini-card__label" data-i18n="home.why.item2.title"
              >Strategy-First Approach</span
            >
            <p data-i18n="home.why.item2.text">
              Technology decisions driven by business goals, not trends. Every
              recommendation is tied to measurable outcomes.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="proof-strip">
    <div class="container">
      <div class="proof-strip__shell">
        <div class="proof-strip__brand-block" data-aos="fade-up">
          <p class="proof-strip__label" data-i18n="home.trusted.label">
            Trusted by growing businesses
          </p>
        </div>

        <div class="proof-strip__stats" data-aos="fade-up" data-aos-delay="100">
          <div class="proof-stat">
            <strong>50+</strong>
            <span data-i18n="home.stat.projects">Projects Delivered</span>
          </div>
          <div class="proof-stat">
            <strong>10+</strong>
            <span data-i18n="home.stat.experience">Years Experience</span>
          </div>
          <div class="proof-stat">
            <strong>98%</strong>
            <span data-i18n="home.stat.satisfaction">Client Satisfaction</span>
          </div>
          <div class="proof-stat">
            <strong>24/7</strong>
            <span data-i18n="home.stat.support">Support Available</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="clients section insight-section" id="clients-section">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section__label" data-i18n="home.clients.label"
          >Our Clients</span
        >
        <h2 class="section__title" data-i18n="home.clients.title">
          We partner with ambitious businesses across industries
        </h2>
        <p class="section__subtitle" data-i18n="home.clients.subtitle">
          From tech startups to established enterprises, we help organizations
          leverage technology for growth and innovation.
        </p>
      </div>

      <div class="clients__logos" data-aos="fade-up" data-aos-delay="50">
        <div class="clients__track">
          <img src="/images/clients/google.png" alt="Google" />
          <img src="/images/clients/netflix.png" alt="Netflix" />
          <img src="/images/clients/spotify.png" alt="Spotify" />
          <img src="/images/clients/airbnb.png" alt="Airbnb" />
          <img src="/images/clients/microsoft.png" alt="Microsoft" />
          <img src="/images/clients/paypal.png" alt="Paypal" />
          <img src="/images/clients/amazon.png" alt="Amazon" />
          <img src="/images/clients/adobe.png" alt="Adobe" />
          <!-- Duplikat -->
          <img src="/images/clients/google.png" alt="Google" />
          <img src="/images/clients/netflix.png" alt="Netflix" />
          <img src="/images/clients/spotify.png" alt="Spotify" />
          <img src="/images/clients/airbnb.png" alt="Airbnb" />
          <img src="/images/clients/microsoft.png" alt="Microsoft" />
          <img src="/images/clients/paypal.png" alt="Paypal" />
          <img src="/images/clients/amazon.png" alt="Amazon" />
          <img src="/images/clients/adobe.png" alt="Adobe" />
        </div>
      </div>
    </div>
  </section>

  <!-- Services  -->
  <section class="section insight-section" id="services-section">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section__label" data-i18n="home.services.label"
          >Our Services</span
        >
        <h2 class="section__title" data-i18n="home.services.title">
          Comprehensive IT solutions for your business
        </h2>
        <p class="section__subtitle" data-i18n="home.services.subtitle">
          From strategy to execution, we provide end-to-end technology services
          tailored to your specific needs.
        </p>
      </div>

      <div class="services-grid">
        {
          services.slice(0, 6).map((service) => (
            <a
              href={service.href}
              class="service-card"
              data-aos="fade-up"
              data-aos-delay={service.delay}
            >
              <div class="service-card__icon" set:html={service.icon} />
              <h3 class="service-card__title" data-i18n={service.titleKey} />
              <p class="service-card__text" data-i18n={service.textKey} />
              <span class="service-card__link" data-i18n="home.feature.learn">
                Learn more →
              </span>
            </a>
          ))
        }
      </div>
      <div class="btn-view" data-aos="fade-up" data-aos-delay="350">
        <a
          href="/services"
          class="btn btn--primary btn--large"
          data-i18n="services.view.details"
        >
          View All Services
        </a>
      </div>
    </div>
  </section>

  <!-- Technology We Use -->
  <section class="section insight-section tech" id="technology-section">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section__label" data-i18n="home.technology.label">
          Technology
        </span>
        <h2 class="section__title" data-i18n="home.technology.title">
          Modern tools powering our solutions
        </h2>
        <p class="section__subtitle" data-i18n="home.technology.subtitle">
          We use proven technologies across frontend, backend, and
          infrastructure to deliver scalable and reliable systems.
        </p>
      </div>

      <div class="tech__logos" data-aos="fade-up" data-aos-delay="50">
        <div class="tech__track">
          <!-- Frontend -->
          <img src="/images/tech/vuejs.webp" alt="Vue.js" loading="lazy" />
          <img src="/images/tech/nextjs.webp" alt="Next.js" loading="lazy" />
          <img src="/images/tech/reactjs.webp" alt="React.js" loading="lazy" />
          <img src="/images/tech/astro.svg" alt="Astro" loading="lazy" />
          <!-- Backend -->
          <img src="/images/tech/laravel.webp" alt="Laravel" loading="lazy" />
          <img src="/images/tech/nodejs.webp" alt="Node.js" loading="lazy" />
          <img src="/images/tech/python.webp" alt="Python" loading="lazy" />
          <!-- DevOps -->
          <img src="/images/tech/docker.webp" alt="Docker" loading="lazy" />
          <!-- Database -->
          <img src="/images/tech/MySQL.svg" alt="MySQL" loading="lazy" />

          <!-- Duplikat -->

          <!-- Frontend -->
          <img src="/images/tech/vuejs.webp" alt="Vue.js" loading="lazy" />
          <img src="/images/tech/nextjs.webp" alt="Next.js" loading="lazy" />
          <img src="/images/tech/reactjs.webp" alt="React.js" loading="lazy" />
          <img src="/images/tech/astro.svg" alt="Astro" loading="lazy" />
          <!-- Backend -->
          <img src="/images/tech/laravel.webp" alt="Laravel" loading="lazy" />
          <img src="/images/tech/nodejs.webp" alt="Node.js" loading="lazy" />
          <img src="/images/tech/python.webp" alt="Python" loading="lazy" />
          <!-- DevOps -->
          <img src="/images/tech/docker.webp" alt="Docker" loading="lazy" />
          <!-- Database -->
          <img src="/images/tech/MySQL.svg" alt="MySQL" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Project Showcase -->
  <section class="projects section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="section__label" data-i18n="home.project.label"
          >Our Work</span
        >
        <h2 class="section__title" data-i18n="home.project.title">
          Projects we've delivered
        </h2>
        <p class="section__subtitle" data-i18n="home.project.subtitle">
          Real solutions built for real businesses.
        </p>
      </div>

      <div class="projects-grid">
        {
          projects.slice(0, 6).map((project) => (
            <a
              href={`/projects/${project.key}`}
              class="project-card"
              data-aos="fade-up"
            >
              <div class="project-image">
                <img
                  src={project.image}
                  alt={`project.title.${project.key}`}
                  data-i18n={`project.${project.key}.title`}
                  loading="lazy"
                />
              </div>
              <div class="project-content">
                <span
                  class="project-badge"
                  data-i18n={`project.${project.key}.tech`}
                >
                  Laravel
                </span>
                <h2
                  class="project-card__title"
                  data-i18n={`project.${project.key}.title`}
                >
                  E-commerce Platform
                </h2>
                <p
                  class="project-card__text"
                  data-i18n={`project.${project.key}.description`}
                >
                  Integrated e-commerce solution, including catalog, shopping
                  cart, and payment processing.
                </p>
                <span
                  class="service-card__link"
                  data-i18n="project.viewdetails"
                >
                  View details &rarr;
                </span>
              </div>
            </a>
          ))
        }
      </div>
      <div class="btn-view" data-aos="fade-up" data-aos-delay="350">
        <a
          href="/projects"
          class="btn btn--primary btn--large"
          data-i18n="projects.view.details"
        >
          View All Projects
        </a>
      </div>
    </div>
  </section>

  <section class="section insight-section">
    <div class="container insight-grid">
      <div class="insight-column">
        <div class="section-header section-header--left" data-aos="fade-up">
          <span class="section__label" data-i18n="home.why.label">Why Zeni</span
          >
          <h2 class="section__title" data-i18n="home.why.title">
            Technology that works for your business
          </h2>
          <p class="section__subtitle" data-i18n="home.why.subtitle">
            We combine technical expertise with business understanding to
            deliver solutions that create real impact.
          </p>
        </div>

        <div class="why-stack">
          <article class="why-card" data-aos="fade-up">
            <div class="why-card__meta">
              <span class="why-card__number">01</span>
            </div>
            <div>
              <h3 class="why-card__title" data-i18n="home.why.item1.title">
                No Vendor Lock-In
              </h3>
              <p class="why-card__text" data-i18n="home.why.item1.text">
                We build with open standards and ensure you always own your
                code, data, and infrastructure.
              </p>
            </div>
          </article>
          <article class="why-card" data-aos="fade-up" data-aos-delay="50">
            <div class="why-card__meta">
              <span class="why-card__number">02</span>
            </div>
            <div>
              <h3 class="why-card__title" data-i18n="home.why.item2.title">
                Business-First Approach
              </h3>
              <p class="why-card__text" data-i18n="home.why.item2.text">
                Technology decisions driven by business goals, not trends. Every
                recommendation is tied to measurable outcomes.
              </p>
            </div>
          </article>
          <article class="why-card" data-aos="fade-up" data-aos-delay="100">
            <div class="why-card__meta">
              <span class="why-card__number">03</span>
            </div>
            <div>
              <h3 class="why-card__title" data-i18n="home.why.item3.title">
                Transparent Process
              </h3>
              <p class="why-card__text" data-i18n="home.why.item3.text">
                Clear milestones, regular updates, and documented handovers. You
                always know where your project stands.
              </p>
            </div>
          </article>
        </div>
      </div>

      <div class="insight-column insight-column--process">
        <div class="section-header section-header--left" data-aos="fade-up">
          <span class="section__label" data-i18n="home.process.label"
            >How We Work</span
          >
          <h2 class="section__title" data-i18n="home.process.title">
            Our Process
          </h2>
          <p class="section__subtitle" data-i18n="home.process.intro">
            A structured approach that delivers consistent, high-quality results
            every time.
          </p>
        </div>

        <div class="process-list">
          <article class="process-step" data-aos="fade-up">
            <div class="process-step__rail">
              <span class="process-step__index">1</span>
            </div>
            <div class="process-step__body">
              <h3 class="process-step__title" data-i18n="home.process.d1.title">
                Discovery
              </h3>
              <p class="process-step__text" data-i18n="home.process.d1.text">
                Understand your business, goals, and constraints before
                proposing solutions.
              </p>
            </div>
          </article>
          <article class="process-step" data-aos="fade-up" data-aos-delay="100">
            <div class="process-step__rail">
              <span class="process-step__index">2</span>
            </div>
            <div class="process-step__body">
              <h3 class="process-step__title" data-i18n="home.process.d2.title">
                Plan & Build
              </h3>
              <p class="process-step__text" data-i18n="home.process.d2.text">
                Transparent delivery with clear milestones you can review and
                steer at every stage.
              </p>
            </div>
          </article>
          <article class="process-step" data-aos="fade-up" data-aos-delay="200">
            <div class="process-step__rail">
              <span class="process-step__index">3</span>
            </div>
            <div class="process-step__body">
              <h3 class="process-step__title" data-i18n="home.process.d3.title">
                Optimize & Handover
              </h3>
              <p class="process-step__text" data-i18n="home.process.d3.text">
                Documentation and knowledge transfer built into every
                engagement. You stay in control.
              </p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt enable-overflow testimonials-section">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section__label" data-i18n="home.testimonials.label"
          >Testimonials</span
        >
        <h2 class="section__title" data-i18n="home.testimonials.title">
          What our clients say
        </h2>
      </div>
      <div class="testimonials-grid testimonials-grid--full">
        {
          testimonials.map((testimonial, index) => (
            <article
              class:list={[
                "testimonial-card",
                index === 0 && "testimonial-card--featured",
              ]}
              data-aos="fade-up"
              data-aos-delay={testimonial.delay}
            >
              <div class="testimonial-card__stars" aria-hidden="true">
                <>
                  <span />
                  <span />
                  <span />
                  <span />
                  <span />
                </>
              </div>
              <p
                class="testimonial-card__text"
                data-i18n={testimonial.quoteKey}
              />
              <div class="testimonial-card__author">
                <div class="testimonial-card__avatar">
                  {testimonial.initial}
                </div>
                <div>
                  <strong data-i18n={testimonial.nameKey} />
                  <span data-i18n={testimonial.roleKey} />
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-section__bg"></div>
    <div class="cta-section__image"></div>
    <div class="container cta-section__inner">
      <h2
        class="cta-section__headline"
        data-aos="fade-up"
        data-i18n="home.cta.headline"
      >
        Ready to build systems that scale?
      </h2>
      <p
        class="cta-section__sub"
        data-aos="fade-up"
        data-aos-delay="50"
        data-i18n="home.cta.sub"
      >
        Let's discuss how we can align technology with your business goals. Free
        consultation, no obligations.
      </p>
      <div class="cta-section__buttons" data-aos="fade-up" data-aos-delay="100">
        <a
          href="/contact"
          class="btn btn--white btn--large"
          data-i18n="home.cta.cta1">Book Free Consultation</a
        >
        <a
          href="/services"
          class="btn btn--ghost btn--large"
          data-i18n="home.cta.cta2">Explore Services</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: calc(4rem + var(--space-4xl)) 0
      calc(var(--space-4xl) + var(--space-xl));
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-primary-dark) 52%,
      var(--color-primary-darker) 100%
    );
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 18% 22%,
        rgba(255, 255, 255, 0.12),
        transparent 32%
      ),
      radial-gradient(
        circle at 86% 32%,
        rgba(255, 255, 255, 0.08),
        transparent 26%
      ),
      linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.08) 100%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(19rem, 0.9fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .hero__content {
    max-width: 39rem;
