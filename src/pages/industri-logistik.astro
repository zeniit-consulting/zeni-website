---
import BaseLayout from "../layouts/BaseLayout.astro";
import { logistics } from "../data/logistics";
import Image from "astro/components/Image.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

const { hero, challenges, solutions, advantages, testimonial, faqs } =
  logistics;
---

<BaseLayout
  title="Industri Logistick"
  description="Real projects, real outcomes. How we help businesses build systems that scale."
  noPadding
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero__bg"></div>
    <div class="container page-hero__inner">
      <span
        class="page-hero__badge"
        data-aos="fade-up"
        data-i18n="casestudies.hero.badge">In-Depth Analysis</span
      >
      <!-- <h1 data-aos="fade-up" data-i18n="casestudies.hero.title">
        Industroi Logistik
      </h1> -->
      <h1>Industri Logistik</h1>
      <!-- <p
        class="page-hero__sub"
        data-aos="fade-up"
        data-i18n="casestudies.hero.sub"
      >
        Real projects. Measurable outcomes. Trust through evidence.
      </p> -->
      <p
        class="page-hero__sub"
        data-aos="fade-up"
        
      >
        Sistem logistik yang lebih cerdas untuk pelaporan yang lebih cepat, visibilitas pengiriman yang lebih baik, dan operasional yang lebih efisien.
      </p>
    </div>
  </section>

  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <span class="eyebrow">{hero.eyebrow}</span>
        <h1>{hero.title}</h1>
        <p>
          {hero.description}
        </p>

        <div class="hero-actions">
          <WhatsAppButton
            label="WhatsApp sekarang"
            message="Halo, saya tertarik membuat website untuk bisnis logistik."
            className="btn btn--primary"
          />
          <a href="/contact" class="btn btn-outline"> Jadwalkan konsultasi </a>
        </div>
      </div>

      <div class="hero-image">
        <Image
          src={hero.image}
          alt="Dashboard operasional terpusat"
          loading="lazy"
          width={500}
          height={500}
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Tantangan bisnis yang dihadapi industri logistik</h2>

      <div class="challenge-grid">
        {
          challenges.map((item) => (
            <article class="challenge-card">
              <div class="icon">{item.icon}</div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section solution-section">
    <div class="container">
      <h2>
        Penuhi berbagai kebutuhan industri logistik & transportasi dengan solusi
        terbaik
      </h2>

      <div class="solution-tabs" data-solution-tabs>
        {
          solutions.map((item, index) => (
            <button
              class={`solution-tab ${index === 0 ? "active" : ""}`}
              type="button"
              data-tab={item.id}
            >
              {item.label}
            </button>
          ))
        }
      </div>

      <div class="solution-wrapper">
        {
          solutions.map((item, index) => (
            <article
              class={`solution-panel ${index === 0 ? "active" : ""}`}
              data-panel={item.id}
            >
              <div class="solution-info">
                <div class="solution-info-card">
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <a href="/contact">Jadwalkan konsultasi →</a>
                </div>
              </div>

              <div class="solution-media">
                <img src={item.image} alt={item.title} loading="lazy" />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section advantage-section">
    <div class="container">
      <h2>Keunggulan solusi digital untuk industri logistik</h2>

      <div class="advantage-grid">
        {
          advantages.map((item) => (
            <article class="advantage-card">
              <div class="icon">{item.icon}</div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section testimonial-section">
    <div class="container testimonial-card">
      <div>
        <p>
          {testimonial.quote}
        </p>
        <br />
        <strong>{testimonial.name}</strong>
        <span>{testimonial.company}</span>
      </div>

      <div class="testimonial-avatar">
        <img src={testimonial.image} alt={testimonial.name} loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container faq-container">
      <div class="faq-heading">
        <h2>Frequently Asked Questions</h2>
      </div>

      <div class="faq-list">
        {
          faqs.map((item, index) => (
            <details open={index === 0}>
              <summary>
                <span>{item.question}</span>
              </summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section cta-section" id="consultation">
    <div class="container cta-card">
      <div>
        <h2>Siap kembangkan bisnis logistik Anda?</h2>
        <p>
          Bangun website dan sistem digital yang membantu operasional bisnis
          berjalan lebih rapi.
        </p>

        <div class="hero-actions">
          <WhatsAppButton
            label="Konsultasi via WhatsApp"
            message="Halo, saya tertarik membuat website untuk bisnis logistik."
            className="btn btn--primary"
          />
          <a href="/contact" class="btn btn-outline">Konsultasi gratis</a>
        </div>
      </div>

      <div class="cta-visual">
        <img
          src="/images/industries/logistics/cta.webp"
          alt="Dashboard digital untuk operasional logistik"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ═══ PAGE HERO ═══ */
  .page-hero {
    position: relative;
    padding: calc(4rem + var(--space-3xl)) 0 var(--space-3xl);
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-primary-dark) 60%,
      var(--color-primary-darker) 100%
    );
    overflow: hidden;
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 50% at 70% 30%,
      rgba(255, 255, 255, 0.06) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  .page-hero__badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: var(--space-lg);
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .page-hero__sub {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin: 0;
  }

  /* ════ LOGISTICS PAGE ═══ */

  .container {
    margin: 0 auto;
  }

  .hero {
    padding: 96px 0 80px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 64px;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-primary);
  }

  .hero h1 {
    max-width: 620px;
    margin: 0;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .hero p {
    max-width: 560px;
    margin: 22px 0 0;
    color: #5f6b7a;
    font-size: 18px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 20px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .btn-primary {
    background: #5b3df5;
    color: #fff;
  }

  .btn-outline {
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    background: #fff;
  }

  .hero-visual {
    min-height: 420px;
    border-radius: 32px;
    background:
      radial-gradient(circle at 70% 20%, #ded7ff 0 26%, transparent 27%),
      linear-gradient(135deg, #f6f3ff, #ffffff);
    display: grid;
    place-items: center;
  }

  .visual-card {
    width: min(360px, 90%);
    padding: 32px;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 24px 70px rgba(72, 58, 160, 0.16);
    border: 1px solid rgba(91, 61, 245, 0.12);
  }

  .truck {
    font-size: 96px;
    text-align: center;
  }

  .stats {
    margin-top: 24px;
    padding: 18px;
    border-radius: 18px;
    background: #f5f7ff;
  }

  .stats span {
    display: block;
    color: #6f7787;
    font-size: 14px;
  }

  .stats strong {
    display: block;
    margin-top: 6px;
    color: #172033;
    font-size: 28px;
  }

  .section {
    padding: 72px 0;
  }

  .section h2 {
    max-width: 780px;
    margin: 0 auto 40px;
    text-align: center;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .challenge-grid,
  .advantage-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .challenge-card,
  .advantage-card {
    padding: 28px;
    border-radius: 18px;
    border: 1px solid #e8ebf2;
    background: #fff;
  }

  .challenge-card .icon,
  .advantage-card .icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: #f2efff;
    color: #5b3df5;
    font-weight: 800;
    margin-bottom: 44px;
  }

  .challenge-card h3,
  .advantage-card h3 {
    margin: 0;
    font-size: 17px;
    line-height: 1.35;
  }

  .challenge-card p {
    margin: 12px 0 0;
    color: #667085;
    line-height: 1.6;
    font-size: 14px;
  }

  .solution-section,
  .advantage-section {
    background: #ffffff;
  }

  .solution-card {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    overflow: hidden;
    border-radius: 24px;
    background: #fff;
    border: 1px solid #e7ebf3;
  }

  .solution-content {
    padding: 42px;
    background: #0f2138;
    color: #fff;
  }

  .solution-content span {
    color: #b9c8ff;
    font-weight: 700;
    font-size: 14px;
  }

  .solution-content h3 {
    margin: 18px 0 12px;
    font-size: 28px;
    line-height: 1.25;
  }

  .solution-content p {
    color: #d4dbea;
    line-height: 1.7;
  }

  .solution-content a {
    display: inline-block;
    margin-top: 18px;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  .solution-image {
    min-height: 420px;
    padding: 24px;
    background: #eef3fb;
  }

  .solution-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    padding: 10px;
    margin: 0 auto 24px;
    border-radius: 16px;
    background: #f3f5f9;
  }

  .solution-tab {
    border: 0;
    padding: 10px 14px;
    border-radius: 12px;
    background: transparent;
    color: black;
    font-family:
      "Manrope",
      system-ui,
      -apple-system,
      sans-serif;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
  }

  .solution-tab.active {
    background: var(--color-primary);
    color: #ffffff;
  }

  .solution-wrapper {
    overflow: hidden;
    border-radius: 24px;
    background: #eef3f8;
  }

  .solution-panel {
    display: none;
    grid-template-columns: 0.75fr 1.25fr;
    min-height: 520px;
  }

  .solution-panel.active {
    display: grid;
  }

  .solution-info {
    padding: 32px;
    background: var(--color-primary);
  }

  .solution-info-card {
    padding: 28px;
    border-radius: 14px;
    background: #ffffff;
    border: 1px solid #315cff;
  }

  .solution-info-card h3 {
    margin: 0;
    font-size: 22px;
    line-height: 1.35;
  }

  .solution-info-card p {
    margin: 14px 0 0;
    color: #4b5563;
    line-height: 1.7;
  }

  .solution-info-card a {
    display: inline-block;
    margin-top: 24px;
    color: #315cff;
    font-weight: 700;
    text-decoration: none;
  }

  .solution-media {
    padding: 28px;
  }

  .solution-media img {
    width: 100%;
    height: 100%;
    min-height: 420px;
    object-fit: cover;
    border-radius: 18px;
  }

  .image-placeholder {
    height: 100%;
    border-radius: 20px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #ffffff, #ded7ff);
    color: #5b3df5;
    font-weight: 800;
  }

  .advantage-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .testimonial-card {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 32px;
    align-items: center;
    padding: 42px;
    border-radius: 24px;
    background: #f5f2ef;
  }

  .testimonial-card p {
    font-size: 20px;
    line-height: 1.7;
    color: #273244;
  }

  .testimonial-card strong,
  .testimonial-card span {
    display: block;
  }

  .testimonial-card span {
    margin-top: 4px;
    color: #6b7280;
  }

  .testimonial-avatar {
    height: 220px;
    display: grid;
    place-items: center;
    font-size: 88px;
  }

  .faq-section h2 {
    text-align: left;
    margin-left: 0;
  }

  .faq-list {
    max-width: 760px;
    margin-left: auto;
  }

  details {
    border-top: 1px solid #e5e7eb;
    padding: 22px 0;
  }

  summary {
    cursor: pointer;
    font-weight: 800;
    color: #172033;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "+";
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    display: grid;
    place-items: center;
    border-radius: 999px;

    color: var(--color-primary);
    font-size: 18px;
    font-weight: 800;
    line-height: 1;
  }

  details[open] summary::after {
    content: "−";
  }

  details p {
    margin: 14px 0 0;
    color: #667085;
    line-height: 1.7;
  }

  .cta-card {
    display: grid;
    grid-template-columns: 1fr 360px;
    align-items: center;
    gap: 32px;
    padding: 54px;
    border-radius: 28px;
    border: 1px solid #e6eaf2;
    box-shadow: 0 20px 60px rgba(15, 33, 56, 0.08);
  }

  .cta-card h2 {
    text-align: left;
    margin: 0;
  }

  .cta-card p {
    margin: 16px 0 0;
    color: #667085;
    line-height: 1.7;
  }

  .cta-visual {
  overflow: hidden;
  border-radius: 24px;
}

.cta-visual img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

  @media (max-width: 900px) {
    .hero-grid,
    .solution-card,
    .testimonial-card,
    .cta-card {
      grid-template-columns: 1fr;
    }

    .challenge-grid,
    .advantage-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .faq-list {
      max-width: none;
    }

    .solution-panel,
    .solution-panel.active {
      grid-template-columns: 1fr;
    }

    .solution-media img {
      min-height: 280px;
    }
  }

  @media (max-width: 560px) {
    .container {
      width: min(100% - 28px, 1120px);
    }

    .hero {
      padding-top: 56px;
    }

    .challenge-grid,
    .advantage-grid {
      grid-template-columns: 1fr;
    }

    .solution-content,
    .cta-card {
      padding: 28px;
    }

    .hero-actions {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }
  @media (max-width: 640px) {
    .solution-tab {
      flex: 1 1 calc(50% - 8px);
      white-space: normal;
      text-align: center;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll("[data-tab]");
  const panels = document.querySelectorAll("[data-panel]");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.getAttribute("data-tab");

      tabs.forEach((item) => item.classList.remove("active"));
      panels.forEach((item) => item.classList.remove("active"));

      tab.classList.add("active");
      document
        .querySelector(`[data-panel="${target}"]`)
        ?.classList.add("active");
    });
  });
</script>
