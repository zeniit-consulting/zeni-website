---
import BaseLayout from "../layouts/BaseLayout.astro";
import { caseStudies } from "../data/caseStudies";
import FeaturedStudyCarousel from "../components/FeaturedStudyCarousel.astro";
import { Image } from "astro:assets";
---

<BaseLayout
  title="Case Studies"
  description="Real projects, real outcomes. How we help businesses build systems that scale."
  noPadding
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero__bg"></div>
    <div class="container page-hero__inner">
      <span
        class="page-hero__badge"
        data-aos="fade-up"
        data-i18n="casestudies.hero.badge">In-Depth Analysis</span
      >
      <h1 data-aos="fade-up" data-i18n="casestudies.hero.title">
        Case Studies
      </h1>
      <p
        class="page-hero__sub"
        data-aos="fade-up"
        data-i18n="casestudies.hero.sub"
      >
        Real projects. Measurable outcomes. Trust through evidence.
      </p>
    </div>
  </section>

  <!-- Featured Hero -->
  <section class="featured-hero">
    <div class="container featured-hero__grid">
      <!-- LEFT -->
      <div class="featured-hero__content">
        <span data-i18n="casestudies.featured-hero.eyebrow" class="featured-hero__eyebrow"> Klien kami </span>

        <h1 data-i18n="casestudies.featured-hero.title">Berkembang bersama bisnis modern di Indonesia</h1>

        <p data-i18n="casestudies.featured-hero.description" class="featured-hero__desc">
          Kami membantu perusahaan membangun sistem, automasi, dan infrastruktur
          digital yang scalable untuk operasional yang lebih efisien.
        </p>

        <div class="featured-logos">
          <span>Laravel</span>
          <span>Vue.js</span>
          <span>PostgreSQL</span>
          <span>Astro</span>
          <span>Docker</span>
          <span>Node.js</span>
        </div>
      </div>

      <!-- RIGHT -->
      <FeaturedStudyCarousel />
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-section__header">
        <h2 data-i18n="casestudies.stasts.title">Berkembang bersama Zeni Consulting</h2>

        <p data-i18n="casestudies.stasts.description">
          Solusi teknologi yang membantu bisnis bekerja lebih cepat dan efisien.
        </p>
      </div>

      <div class="stats-grid">
        <div class="stats-card">
          <span data-i18n="casestudies.stasts.label.1" class="stats-card__label"> Project Selesai </span>

          <strong> 15+ </strong>
        </div>

        <div class="stats-card">
          <span data-i18n="casestudies.stasts.label.2" class="stats-card__label"> Sistem Dibangun </span>

          <strong> 30+ </strong>
        </div>

        <div class="stats-card">
          <span data-i18n="casestudies.stasts.label.3" class="stats-card__label"> Kepuasan Klien </span>

          <strong> 98% </strong>
        </div>
      </div>
    </div>
  </section>

  <!-- Case Studies Grid -->
  <section class="case-grid-section">
    <div class="container">
      <!-- Header -->
      <div class="case-grid-header">
        <div>
          <span data-i18n="casestudies.eyebrow" class="case-grid-header__eyebrow"> Case Studies </span>

          <h2 data-i18n="casestudies.title">Solusi nyata untuk bisnis modern</h2>
        </div>

        <p data-i18n="casestudies.description">
          Studi kasus pilihan dari project yang kami kerjakan untuk membantu
          bisnis berkembang lebih cepat dan efisien.
        </p>
      </div>

      <!-- Filters -->
      <div class="case-filters">
        <button
          type="button"
          class="case-filter active"
          aria-pressed="true"
          data-filter="all"
          data-i18n="casestudies.filters.all"
        >
          Semua
        </button>

        <button
          type="button"
          class="case-filter"
          aria-pressed="false"
          data-filter="AUTOMATION SYSTEM"
           data-i18n="casestudies.filters.automation"
        >
          Automation
        </button>

        <button
          type="button"
          class="case-filter"
          aria-pressed="false"
          data-filter="INTERNAL DASHBOARD"
           data-i18n="casestudies.filters.dashboard"
        >
          Dashboard
        </button>

        <button
          type="button"
          class="case-filter"
          aria-pressed="false"
          data-filter="SYSTEM INTEGRATION"
           data-i18n="casestudies.filters.integration"
        >
          Integration
        </button>

        <button
          type="button"
          class="case-filter"
          aria-pressed="false"
          data-filter="AI AUTOMATION"
           data-i18n="casestudies.filters.aisystems"
        >
          AI Systems
        </button>
      </div>

      <!-- Grid -->
      <div class="projects-grid" id="caseGrid">
        {
          caseStudies.map((study, index) => (
            <a
              href={`/case-studies/${study.slug}`}
              class:list={["project-card", index >= 3 && "is-initial-hidden"]}  
              data-category={study.category}
              
            >
              <div class="project-image">
                <Image
                  src={study.image}
                  alt={study.title}
                  width={400}
                  height={250}
                  quality={60}
                  widths={[320, 400, 640, 800]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
                  decoding="async"
                  loading="lazy"
                  fetchpriority={index === 0 ? "high" : "auto"}
                />
              </div>

              <div class="project-content">
                <span data-i18n={`casestudies.${study.key}.category`} class="project-badge">AUTOMATION SYSTEM</span>

                <h3 data-i18n={`casestudies.${study.key}.title`} class="project-card__title">
                  {study.title.length > 50
                    ? study.title.slice(0, 50) + "..."
                    : study.title}
                </h3>

                <span
                  class="service-card__link"
                  data-i18n="project.viewdetails"
                >
                  View details &rarr;
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Pagination -->
    <!-- <div class="case-pagination" id="casePagination">
      <button class="case-pagination__btn active"> 1 </button>

      <button class="case-pagination__btn"> 2 </button>

      <button class="case-pagination__btn"> 3 </button>

      <button class="case-pagination__btn"> → </button>
    </div> -->
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-box">
        <!-- LEFT -->
        <div class="cta-box__content">
          <span data-i18n="casestudies.cta-section.badge" class="cta-box__badge"> LET'S WORK TOGETHER </span>

          <h2 data-i18n="casestudies.cta-section.title">Build Smarter Systems For Your Growing Business</h2>

          <p data-i18n="casestudies.cta-section.text">
            We help companies streamline operations, automate workflows, and
            create scalable digital systems for long-term growth.
          </p>

          <div class="cta-box__actions">
            <a href="/contact" class="cta-btn cta-btn--primary">
              <span data-i18n="casestudies.cta-section.btn-start">Start Consultation</span>
            </a>

            <a href="/services" class="cta-btn cta-btn--secondary">
              <span data-i18n="casestudies.cta-section.btn-service">Explore Our Services</span>
            </a>
          </div>
        </div>

        <!-- RIGHT -->
        <div class="cta-box__image">
          <img
            src="/images/cta/business-team.webp"
            alt="Business consultation"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ═══ PAGE HERO ═══ */
  .page-hero {
    position: relative;
    padding: calc(4rem + var(--space-3xl)) 0 var(--space-3xl);
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-primary-dark) 60%,
      var(--color-primary-darker) 100%
    );
    overflow: hidden;
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 50% at 70% 30%,
      rgba(255, 255, 255, 0.06) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  .page-hero__badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: var(--space-lg);
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .page-hero__sub {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin: 0;
  }

  /* ═══ FEATURED HERO ═══ */

  .featured-hero {
    padding: calc(2rem + var(--space-xl)) 0 var(--space-3xl);

    background: #ffffff;
  }

  .featured-hero .container {
    margin: 0 auto;
  }

  .featured-hero__grid {
    display: grid;
    grid-template-columns: 1fr 480px;
    gap: 4rem;
    align-items: center;
  }

  .featured-hero__content {
    max-width: 40rem;
  }

  .featured-hero__eyebrow {
    display: inline-block;

    font-size: 0.875rem;
    color: var(--color-neutral-500);

    margin-bottom: 1rem;
  }

  .featured-hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);

    line-height: 1.1;
    letter-spacing: -0.04em;

    margin-bottom: 1.5rem;

    color: var(--color-neutral-900);
  }

  .featured-hero__desc {
    font-size: 1.0625rem;
    line-height: 1.8;

    color: var(--color-neutral-600);

    max-width: 36rem;
  }

  .featured-logos {
    display: flex;
    flex-wrap: wrap;

    gap: 1rem;

    margin-top: 2.5rem;
  }

  .featured-logos span {
    padding: 0.75rem 1rem;

    border-radius: 0.75rem;

    background: var(--color-neutral-100);

    font-size: 0.875rem;
    font-weight: 600;

    color: var(--color-neutral-700);
  }

  /* ═══ STATS SECTION ═══ */

  .stats-section {
    padding: var(--space-3xl) 0;

    background: var(--color-neutral-100);
  }

  .stats-section__header {
    text-align: center;

    max-width: 42rem;

    margin: 0 auto 3rem;
  }

  .stats-section__header h2 {
    margin-bottom: 1rem;

    font-size: 2.25rem;
  }

  .stats-section__header p {
    color: var(--color-neutral-600);

    line-height: 1.8;
  }

  .stats-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 1.5rem;

    max-width: 56rem;

    margin: 0 auto;
  }

  .stats-card {
    background: white;

    border: 1px solid var(--color-neutral-200);

    border-radius: 1rem;

    padding: 2rem;

    text-align: center;
  }

  .stats-card__label {
    display: block;

    margin-bottom: 0.75rem;

    font-size: 0.875rem;

    color: var(--color-neutral-500);
  }

  .stats-card strong {
    font-size: 2rem;

    line-height: 1;

    color: var(--color-neutral-900);
  }

  /* ═══ CASE GRID ═══ */

  .case-grid-section {
    padding: var(--space-3xl) 0;

    background: white;
  }
  .case-grid-card {
    overflow: hidden;
  }
  .case-grid-section .container {
    padding-inline: 2rem;
  }

  .case-grid-header {
    display: flex;
    justify-content: space-between;
    align-items: end;

    gap: 2rem;

    margin-bottom: 3rem;
  }

  .case-grid-header__eyebrow {
    display: inline-block;

    margin-bottom: 1rem;

    font-size: 0.875rem;

    color: var(--color-neutral-500);
  }

  .case-grid-header h2 {
    font-size: 2.5rem;

    line-height: 1.1;

    max-width: 32rem;
  }

  .case-grid-header p {
    max-width: 28rem;

    color: var(--color-neutral-600);

    line-height: 1.8;
  }

  /* ═══ FILTERS ═══ */

  .case-filters {
    display: flex;
    flex-wrap: wrap;

    gap: 0.75rem;

    margin-bottom: 2.5rem;
  }

  .case-filter {
    padding: 0.75rem 1rem;

    border-radius: 999px;

    border: 1px solid var(--color-neutral-200);

    background: white;

    color: var(--color-neutral-600);

    font-size: 0.875rem;
    font-weight: 500;

    cursor: pointer;

    transition: all 0.25s ease;
  }

  .case-filter:hover {
    border-color: var(--color-primary);

    color: var(--color-primary);
  }

  .case-filter.active {
    background: var(--color-primary);

    border-color: var(--color-primary);

    color: white;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    margin-top: 50px;
  }

  .project-card {
    background: #ffffff;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    transition: all 0.4s ease;
    cursor: pointer;
    position: relative;
  }

  .project-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15);
  }

  .project-card.is-initial-hidden {
    display: none;
  }

  .projects-grid.is-filtering .project-card.is-initial-hidden {
    display: block;
  }

  .project-card.is-hidden {
    display: none !important;
  }

  .project-image {
    overflow: hidden;
    height: 240px;
    position: relative;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .project-card:hover .project-image img {
    transform: scale(1.08);
  }

  .project-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.15), transparent);
  }

  .project-content {
    padding: 28px;
  }

  .project-content h3 {
    font-size: 24px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 10px;
    font-family: "Poppins", sans-serif;
  }

  .project-content p {
    font-size: 15px;
    color: #6b7280;
    line-height: 1.6;
    font-family: "Inter", sans-serif;
  }

  .project-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 5px;
    width: 100%;
    background: linear-gradient(90deg, #2563eb, #06b6d4);
  }
  .project-badge {
    display: inline-block;
    padding: 6px 14px;
    background: #eff6ff;
    color: #2563eb;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 14px;
  }

  .project-card__title {
    font-size: 1.125rem;
    margin-bottom: var(--space-sm);
    color: var(--color-neutral-900);
  }

  .project-card__text {
    font-size: 0.9375rem;
    color: var(--color-neutral-600);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
    flex: 1;
  }

  /* ═══ PAGINATION ═══ */

  /* .case-pagination {
    display: flex;

    justify-content: center;

    gap: 0.75rem;

    margin-top: 4rem;
  }

  .case-pagination__btn {
    width: 44px;
    height: 44px;

    border-radius: 999px;

    border: 1px solid var(--color-neutral-200);

    background: white;

    font-weight: 600;

    cursor: pointer;

    transition: all 0.25s ease;
  }

  .case-pagination__btn:hover {
    border-color: var(--color-primary);

    color: var(--color-primary);
  }

  .case-pagination__btn.active {
    background: var(--color-primary);

    border-color: var(--color-primary);

    color: white;
  } */

  /* ═══ CTA ═══ */

  .cta-section {
    padding: 6rem 0;
  }

  /* BOX */

  .cta-box {
    display: grid;

    grid-template-columns:
      1.1fr
      0.9fr;

    align-items: center;

    gap: 3rem;

    padding: 4rem;

    border-radius: 2rem;

    background: #f8fafc;

    overflow: hidden;
  }

  /* LEFT */

  .cta-box__content {
    max-width: 620px;
  }

  /* BADGE */

  .cta-box__badge {
    display: inline-flex;

    margin-bottom: 1rem;

    padding: 0.45rem 0.9rem;

    border-radius: 999px;

    background: rgba(37, 99, 235, 0.08);

    color: var(--color-primary);

    font-size: 0.72rem;
    font-weight: 700;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  /* TITLE */

  .cta-box h2 {
    margin-bottom: 1.25rem;

    font-size: clamp(2.2rem, 4vw, 3.5rem);

    line-height: 1.15;

    color: var(--color-neutral-900);
  }

  /* TEXT */

  .cta-box p {
    max-width: 560px;

    margin-bottom: 2rem;

    color: var(--color-neutral-600);

    font-size: 1.05rem;

    line-height: 1.8;
  }

  /* BUTTONS */

  .cta-box__actions {
    display: flex;

    gap: 1rem;

    flex-wrap: wrap;
  }

  .cta-btn {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 1rem 1.5rem;

    border-radius: 1rem;

    text-decoration: none;

    font-weight: 600;

    transition: all 0.3s ease;
  }

  /* PRIMARY */

  .cta-btn--primary {
    background: var(--color-primary);

    color: white;
  }

  .cta-btn--primary:hover {
    transform: translateY(-2px);

    box-shadow: 0 12px 24px rgba(37, 99, 235, 0.18);
  }

  /* SECONDARY */

  .cta-btn--secondary {
    border: 1px solid rgba(37, 99, 235, 0.2);

    color: var(--color-primary);

    background: white;
  }

  .cta-btn--secondary:hover {
    background: rgba(37, 99, 235, 0.04);
  }

  /* IMAGE */

  .cta-box__image {
    position: relative;
  }

  .cta-box__image img {
    width: 100%;

    display: block;

    object-fit: contain;
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 768px) {
    .page-hero {
      padding: calc(4rem + var(--space-2xl)) 0 var(--space-2xl);
    }

    .case-card {
      grid-template-columns: 1fr;
    }

    .case-card__sidebar {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      border-right: none;
      border-bottom: 1px solid var(--color-neutral-200);
      padding: var(--space-lg);
    }

    .case-card__metrics {
      flex-direction: row;
      gap: var(--space-lg);
      margin-top: var(--space-sm);
    }

    .metric-item {
      flex: 1;
    }

    .featured-hero__grid {
      grid-template-columns: 1fr;
    }

    .featured-study {
      max-width: 100%;
    }
    .stats-grid {
      grid-template-columns: 1fr;
    }

    .case-grid-header {
      flex-direction: column;
      align-items: start;
    }

    .case-grid {
      grid-template-columns: 1fr;
    }

    .case-filters {
      overflow-x: auto;
      flex-wrap: nowrap;

      padding-bottom: 0.5rem;
    }
  }

  @media (max-width: 900px) {
    .cta-box {
      grid-template-columns: 1fr;

      padding: 3rem 2rem;

      text-align: center;
    }

    .cta-box__content {
      margin: 0 auto;
    }

    .cta-box__actions {
      justify-content: center;
    }

    .cta-box__image {
      max-width: 420px;

      margin: 0 auto;
    }
    .case-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .cta-section {
      padding: 4rem 0;
    }

    .cta-box {
      padding: 2rem 1.25rem;

      border-radius: 1.5rem;
    }

    .cta-box h2 {
      font-size: 2rem;
    }

    .cta-box__actions {
      flex-direction: column;
    }

    .cta-btn {
      width: 100%;
    }
    .case-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const filterButtons =
    document.querySelectorAll<HTMLButtonElement>(".case-filter");

  const caseGrid = document.querySelector<HTMLElement>("#caseGrid");

  const projectCards =
    document.querySelectorAll<HTMLElement>("#caseGrid .project-card");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const selectedFilter = button.dataset.filter ?? "all";
      const isAll = selectedFilter === "all";

      filterButtons.forEach((item) => {
        const isActive = item === button;
        item.classList.toggle("active", isActive);
        item.setAttribute("aria-pressed", String(isActive));
      });

      caseGrid?.classList.toggle("is-filtering", !isAll);

      projectCards.forEach((card) => {
        const cardCategory = card.dataset.category ?? "";

        const shouldShow = isAll || cardCategory === selectedFilter;

        card.classList.toggle("is-hidden", !shouldShow);
      });
    });
  });
</script>


