---
import BaseLayout from "../layouts/BaseLayout.astro";
import { helpCategories, popularQuestions } from "../data/helpCenter";
import WhatsAppButton from "../components/WhatsAppButton.astro";

const totalArticles = helpCategories.reduce(
  (total, category) => total + category.articles.length,
  0,
);
---

<BaseLayout
  title="Pusat Bantuan"
  description="Temukan jawaban dan panduan seputar layanan Zeni Consulting."
  noPadding
>
  <div class="help-page">
    <section class="help-hero">
      <div class="help-hero__pattern" aria-hidden="true"></div>

      <div class="container help-hero__layout">
        <div class="help-hero__content">
          <span class="help-eyebrow">Pusat Bantuan</span>
          <h1>Temukan jawaban untuk kebutuhan digital Anda.</h1>
          <p>
            Akses panduan layanan, proses kerja, dan dukungan teknis Zeni
            Consulting dalam satu tempat yang mudah dicari.
          </p>

          <div class="help-search" role="search">
            <span class="help-search__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path
                  d="m20 20-4.2-4.2m1.2-5a6.2 6.2 0 1 1-12.4 0 6.2 6.2 0 0 1 12.4 0Z"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                ></path>
              </svg>
            </span>
            <input
              id="helpSearchInput"
              type="text"
              aria-label="Cari bantuan"
              placeholder="Cari layanan, proses kerja, atau support..."
            />
          </div>

          <div class="help-stats" aria-label="Ringkasan pusat bantuan">
            <div>
              <strong>{helpCategories.length}</strong>
              <span>Kategori</span>
            </div>
            <div>
              <strong>{totalArticles}</strong>
              <span>Artikel bantuan</span>
            </div>
            <div>
              <strong>1:1</strong>
              <span>Arahan konsultasi</span>
            </div>
          </div>
        </div>

        <aside class="help-hero__panel" aria-label="Topik bantuan cepat">
          <span class="help-panel__label">Mulai dari sini</span>
          <h2>Topik yang paling sering dicari</h2>
          <p>
            Pilih kategori untuk melihat panduan dan jawaban yang relevan dengan
            kebutuhan bisnis Anda.
          </p>

          <div class="help-panel__links">
            {
              helpCategories.slice(0, 3).map((item, index) => (
                <a href={`/help-center/${item.slug}`}>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{item.title}</strong>
                </a>
              ))
            }
          </div>
        </aside>
      </div>
    </section>

    <section class="help-section">
      <div class="container">
        <div class="help-section__header">
          <span class="help-eyebrow">Knowledge base</span>
          <h2>Pilih kategori bantuan</h2>
          <p>
            Semua panduan disusun berdasarkan alur kerja nyata agar Anda bisa
            menemukan informasi dengan cepat.
          </p>
        </div>

        <div class="help-grid">
          {
            helpCategories.map((item, index) => (
              <article
                class="help-card"
                data-help-card
                data-search={`${item.title} ${item.description} ${item.articles
                  .map((article) => `${article.title} ${article.content}`)
                  .join(" ")}`}
              >
                <div class="help-card__top">
                  <span class="help-card__number">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="help-card__count">
                    {item.articles.length} artikel
                  </span>
                </div>

                <h3>{item.title}</h3>
                <p>{item.description}</p>

                <a class="help-card__link" href={`/help-center/${item.slug}`}>
                  Lihat panduan <span aria-hidden="true">&rarr;</span>
                </a>
              </article>
            ))
          }
        </div>

        <p class="help-empty" id="helpEmpty">
          Tidak ada bantuan yang cocok dengan pencarian Anda.
        </p>
      </div>
    </section>

    <section class="help-popular">
      <div class="container help-popular__layout">
        <div class="help-popular__intro">
          <span class="help-eyebrow">FAQ populer</span>
          <h2>Pertanyaan yang sering diajukan</h2>
          <p>
            Jawaban cepat untuk pertanyaan yang biasanya muncul saat mulai
            berdiskusi dengan tim Zeni Consulting.
          </p>
        </div>

        <div class="popular-list">
          {
            popularQuestions.map((item, index) => (
              <a href={item.href} class="popular-item">
                <span class="popular-item__number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="popular-item__title">{item.title}</span>
                <span class="popular-item__arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="help-cta">
      <div class="container">
        <div class="help-cta__box">
          <div class="help-cta__content">
            <span class="help-eyebrow">Masih butuh bantuan?</span>
            <h2>Diskusikan kebutuhan bisnis Anda dengan tim kami.</h2>
            <p>
              Ceritakan konteks bisnis, tantangan operasional, atau ide sistem
              yang ingin Anda bangun. Tim Zeni Consulting akan membantu memberi
              arahan awal yang jelas.
            </p>
          </div>

          <div class="help-cta__actions">
            <WhatsAppButton label="Hubungi Kami" className="help-cta__button" />
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .help-page {
    --help-border: rgba(148, 163, 184, 0.26);
    --help-ink: #102033;
    --help-muted: #5d6b7c;
    --help-soft: #f6f9fc;
    --help-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);

    overflow: hidden;
    background:
      linear-gradient(180deg, var(--color-white) 0%, var(--help-soft) 48%, var(--color-white) 100%);
    color: var(--help-ink);
  }

  .help-page h1,
  .help-page h2,
  .help-page h3 {
    color: var(--help-ink);
    letter-spacing: 0;
  }

  .help-eyebrow {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    margin-bottom: 0.875rem;
    color: var(--color-primary);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .help-hero {
    position: relative;
    padding: calc(4rem + 4.5rem) 0 5rem;
    background:
      linear-gradient(135deg, var(--color-primary-50) 0%, #ffffff 52%, #eef6fc 100%);
  }

  .help-hero__pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 96, 175, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 96, 175, 0.06) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.88), transparent 82%);
    pointer-events: none;
  }

  .help-hero__layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 3rem;
    align-items: center;
  }

  .help-hero__content {
    max-width: 45rem;
  }

  .help-hero h1 {
    max-width: 43rem;
    margin: 0 0 1.125rem;
    font-size: 3.25rem;
    line-height: 1.12;
  }

  .help-hero p {
    max-width: 38rem;
    margin: 0 0 1.75rem;
    color: var(--help-muted);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .help-search {
    position: relative;
    max-width: 42rem;
  }

  .help-search__icon {
    position: absolute;
    top: 50%;
    left: 1.125rem;
    display: grid;
    width: 1.375rem;
    height: 1.375rem;
    color: var(--color-primary);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .help-search__icon svg {
    width: 100%;
    height: 100%;
  }

  .help-search input {
    width: 100%;
    min-height: 60px;
    padding: 0 1.25rem 0 3.25rem;
    border: 1px solid rgba(0, 96, 175, 0.18);
    border-radius: var(--radius-md);
    outline: none;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
    color: var(--help-ink);
    font: inherit;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .help-search input:focus {
    border-color: var(--color-primary);
    box-shadow:
      0 0 0 4px rgba(0, 96, 175, 0.12),
      0 16px 36px rgba(15, 23, 42, 0.08);
  }

  .help-search input::placeholder {
    color: var(--color-neutral-400);
  }

  .help-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 1.25rem;
  }

  .help-stats div {
    display: grid;
    min-width: 9rem;
    gap: 0.125rem;
    padding: 1rem 1.125rem;
    border: 1px solid rgba(0, 96, 175, 0.12);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.76);
  }

  .help-stats strong {
    color: var(--color-primary);
    font-size: 1.375rem;
    line-height: 1;
  }

  .help-stats span {
    color: var(--help-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .help-hero__panel {
    padding: 1.5rem;
    border: 1px solid rgba(0, 96, 175, 0.16);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.86);
    box-shadow: var(--help-shadow);
    backdrop-filter: blur(14px);
  }

  .help-panel__label {
    display: inline-flex;
    margin-bottom: 0.875rem;
    color: var(--color-primary);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .help-hero__panel h2 {
    margin: 0 0 0.75rem;
    font-size: 1.375rem;
    line-height: 1.35;
  }

  .help-hero__panel p {
    margin: 0 0 1.25rem;
    color: var(--help-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .help-panel__links {
    display: grid;
    gap: 0.75rem;
  }

  .help-panel__links a {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem;
    border: 1px solid var(--help-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    color: var(--help-ink);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .help-panel__links a:hover {
    transform: translateY(-2px);
    border-color: rgba(0, 96, 175, 0.28);
    box-shadow: 0 12px 24px rgba(15, 23, 42, 0.07);
  }

  .help-panel__links span {
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-primary-50);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .help-panel__links strong {
    color: var(--help-ink);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .help-section {
    padding: 4.75rem 0 4rem;
  }

  .help-section__header,
  .help-popular__intro {
    max-width: 39rem;
  }

  .help-section__header {
    margin-bottom: 1.75rem;
  }

  .help-section__header h2,
  .help-popular__intro h2 {
    margin: 0 0 0.875rem;
    font-size: 2rem;
    line-height: 1.25;
  }

  .help-section__header p,
  .help-popular__intro p {
    color: var(--help-muted);
    line-height: 1.75;
  }

  .help-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .help-card {
    display: flex;
    min-height: 17.5rem;
    flex-direction: column;
    padding: 1.375rem;
    border: 1px solid var(--help-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
    transition:
      transform var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .help-card:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 96, 175, 0.26);
    box-shadow: var(--help-shadow);
  }

  .help-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.375rem;
  }

  .help-card__number {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-primary-50);
    color: var(--color-primary);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .help-card__count {
    color: var(--help-muted);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .help-card h3 {
    margin: 0 0 0.75rem;
    font-size: 1.125rem;
    line-height: 1.4;
  }

  .help-card p {
    margin: 0 0 1.25rem;
    color: var(--help-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .help-card__link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    color: var(--color-primary);
    font-size: 0.9375rem;
    font-weight: 800;
  }

  .help-card__link span {
    transition: transform var(--transition-fast);
  }

  .help-card__link:hover span {
    transform: translateX(3px);
  }

  .help-card.is-hidden {
    display: none;
  }

  .help-empty {
    display: none;
    margin-top: 1.5rem;
    padding: 1rem 1.125rem;
    border: 1px dashed var(--help-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    color: var(--help-muted);
  }

  .help-empty.is-visible {
    display: block;
  }

  .help-popular {
    padding: 1rem 0 4.75rem;
  }

  .help-popular__layout {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
    gap: 3rem;
    align-items: start;
  }

  .popular-list {
    display: grid;
    gap: 0.875rem;
  }

  .popular-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    min-height: 4.75rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--help-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    color: var(--help-ink);
    transition:
      transform var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .popular-item:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 96, 175, 0.26);
    box-shadow: 0 16px 34px rgba(15, 23, 42, 0.07);
  }

  .popular-item__number {
    display: grid;
    width: 2.125rem;
    height: 2.125rem;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-neutral-100);
    color: var(--help-muted);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .popular-item__title {
    color: var(--help-ink);
    font-weight: 700;
    line-height: 1.55;
  }

  .popular-item__arrow {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-primary-50);
    color: var(--color-primary);
    font-weight: 800;
    transition:
      background var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .popular-item:hover .popular-item__arrow {
    background: var(--color-primary);
    color: var(--color-white);
    transform: translateX(2px);
  }

  .help-cta {
    padding: 0 0 5.5rem;
  }

  .help-cta__box {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    padding: 2rem;
    border: 1px solid rgba(0, 96, 175, 0.18);
    border-radius: var(--radius-md);
    background:
      linear-gradient(135deg, var(--color-primary-50) 0%, #ffffff 58%, #eef6fc 100%);
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.07);
  }

  .help-cta__content {
    max-width: 44rem;
  }

  .help-cta h2 {
    margin: 0 0 0.875rem;
    font-size: 1.75rem;
    line-height: 1.3;
  }

  .help-cta p {
    margin: 0;
    color: var(--help-muted);
    line-height: 1.75;
  }

  .help-cta__actions {
    display: flex;
    justify-content: flex-end;
  }

  :global(.help-cta__button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 1.25rem;
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-white);
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 14px 28px rgba(0, 96, 175, 0.2);
    transition:
      transform var(--transition-fast),
      background var(--transition-fast),
      box-shadow var(--transition-fast);
    white-space: nowrap;
  }

  :global(.help-cta__button:hover) {
    transform: translateY(-2px);
    background: var(--color-primary-dark);
    color: var(--color-white);
    box-shadow: 0 18px 34px rgba(0, 96, 175, 0.24);
  }

  .help-card a:focus-visible,
  .popular-item:focus-visible,
  .help-panel__links a:focus-visible,
  :global(.help-cta__button:focus-visible) {
    outline: 3px solid rgba(0, 96, 175, 0.22);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .help-search input,
    .help-panel__links a,
    .help-card,
    .help-card__link span,
    .popular-item,
    .popular-item__arrow,
    :global(.help-cta__button) {
      transition: none;
    }
  }

  @media (max-width: 1080px) {
    .help-hero__layout,
    .help-popular__layout,
    .help-cta__box {
      grid-template-columns: 1fr;
    }

    .help-hero__panel {
      max-width: 42rem;
    }

    .help-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .help-cta__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 760px) {
    .help-hero {
      padding: calc(4rem + 3rem) 0 3.75rem;
    }

    .help-hero__layout {
      gap: 2rem;
    }

    .help-hero h1 {
      font-size: 2.5rem;
    }

    .help-hero p {
      font-size: 1rem;
    }

    .help-stats div {
      min-width: calc(50% - 0.5rem);
    }

    .help-section {
      padding: 3.5rem 0 3rem;
    }

    .help-popular {
      padding-bottom: 3.5rem;
    }

    .help-section__header h2,
    .help-popular__intro h2 {
      font-size: 1.625rem;
    }

    .popular-item {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .popular-item__arrow {
      grid-column: 2;
      justify-self: start;
    }

    .help-cta {
      padding-bottom: 4rem;
    }
  }

  @media (max-width: 560px) {
    .help-hero h1 {
      font-size: 2.125rem;
    }

    .help-search input {
      min-height: 56px;
    }

    .help-stats {
      display: grid;
      grid-template-columns: 1fr;
    }

    .help-stats div {
      min-width: 0;
    }

    .help-grid {
      grid-template-columns: 1fr;
    }

    .help-card {
      min-height: auto;
    }

    .help-hero__panel,
    .help-card,
    .help-cta__box {
      padding: 1.25rem;
    }

    :global(.help-cta__button) {
      width: 100%;
    }
  }
</style>

<script>
  const searchInput =
    document.querySelector<HTMLInputElement>("#helpSearchInput");

  const helpCards = document.querySelectorAll<HTMLElement>("[data-help-card]");

  const emptyState = document.querySelector<HTMLElement>("#helpEmpty");

  if (searchInput && helpCards.length > 0) {
    searchInput.addEventListener("input", () => {
      const keyword = searchInput.value.toLowerCase().trim();

      let visibleCount = 0;

      helpCards.forEach((card) => {
        const searchText = card.dataset.search?.toLowerCase() || "";
        const isMatch = searchText.includes(keyword);

        card.classList.toggle("is-hidden", !isMatch);

        if (isMatch) visibleCount++;
      });

      if (emptyState) {
        emptyState.classList.toggle("is-visible", visibleCount === 0);
      }
    });
  }
</script>
