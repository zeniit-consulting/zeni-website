---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Schedule a consultation. We'd love to hear about your technology challenges."
  noPadding
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero__bg"></div>
    <div class="container page-hero__inner">
      <span
        class="page-hero__badge"
        data-aos="fade-up"
        data-i18n="contact.hero.badge">Get In Touch</span
      >
      <h1 data-aos="fade-up" data-i18n="contact.hero.title">Contact Us</h1>
      <p class="page-hero__sub" data-aos="fade-up" data-i18n="contact.hero.sub">
        Let's start a conversation. Tell us about your challenges and we'll find
        the right solution together.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <!-- Contact Form -->
        <div class="contact-form-wrapper" data-aos="fade-up">
          <h2 data-i18n="contact.form.title">Send a message</h2>
          <p class="contact-form__desc" data-i18n="contact.form.desc">
            Fill out the form below and we'll get back to you within 24 hours.
          </p>
          <form id="contactForm" class="contact-form" action="#" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label for="name" data-i18n="contact.form.name">Name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Your name"
                  data-i18n-ph="contact.form.name.ph"
                />
              </div>
              <div class="form-group">
                <label for="email" data-i18n="contact.form.email">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="you@company.com"
                  data-i18n-ph="contact.form.email.ph"
                />
              </div>
            </div>
            <div class="form-group">
              <label for="company" data-i18n="contact.form.company"
                >Company (optional)</label
              >
              <input
                type="text"
                id="company"
                name="company"
                placeholder="Your company"
                data-i18n-ph="contact.form.company.ph"
              />
            </div>
            <div class="form-group">
              <label for="service" data-i18n="contact.form.service"
                >Service interested in</label
              >
              <select id="service" name="service" required>
                <option value="" data-i18n="contact.form.service.default">
                  Select a service...
                </option>
                <option
                  value="development"
                  data-i18n="contact.form.service.dev"
                >
                 Pengembangan Web
                </option>
                <option value="hardware" data-i18n="contact.form.service.hw">
                  Pengembangan Aplikasi Mobile
                </option>
                <option value="consulting" data-i18n="contact.form.service.it">
                  Pengembangan Software
                </option>
                <option value="automation" data-i18n="contact.form.service.ai">
                  Konsultan IT
                </option>
                <option value="audit" data-i18n="contact.form.service.audit">
                  Technology Audit
                </option>
                <option
                  value="strategy"
                  data-i18n="contact.form.service.strategy"
                >
                  IT Strategy & Advisory
                </option>
                <option value="other" data-i18n="contact.form.service.other">
                  Other
                </option>
              </select>
            </div>
            <div class="form-group">
              <label for="message" data-i18n="contact.form.message"
                >Message</label
              >
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="Tell us about your project or challenge..."
                data-i18n-ph="contact.form.message.ph"></textarea>
            </div>
            <button
              type="submit"
              class="btn btn--primary btn--large"
              data-i18n="contact.form.submit">Send Message</button
            >
          </form>
        </div>

        <!-- Contact Channels -->
        <div class="contact-sidebar" data-aos="fade-up" data-aos-delay="100">
          <div class="contact-info-card">
            <h3 data-i18n="contact.channels.title">Other ways to reach us</h3>
            <div class="channel-list">
              <a
                href="https://wa.me/628811841064?text=Halo%2C%20saya%20tertarik%20untuk%20konsultasi%20IT%20dengan%20Zeni%20Consulting."
                class="channel-item"
                target="_blank"
                rel="noopener"
              >
                <div class="channel-item__icon">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    ><path
                      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                    ></path></svg
                  >
                </div>
                <div>
                  <span
                    class="channel-item__label"
                    data-i18n="contact.channels.wa">WhatsApp</span
                  >
                  <span class="channel-item__value">+62 881 1841 064</span>
                </div>
              </a>
              <a href="mailto:hello@zeniconsulting.com" class="channel-item">
                <div class="channel-item__icon">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    ><path
                      d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                    ></path><polyline points="22,6 12,13 2,6"></polyline></svg
                  >
                </div>
                <div>
                  <span
                    class="channel-item__label"
                    data-i18n="contact.channels.email">Email</span
                  >
                  <span class="channel-item__value"
                    >info@zeniconsulting.com</span
                  >
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ═══ PAGE HERO ═══ */
  .page-hero {
    position: relative;
    padding: calc(4rem + var(--space-3xl)) 0 var(--space-3xl);
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-primary-dark) 60%,
      var(--color-primary-darker) 100%
    );
    overflow: hidden;
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 50% at 70% 30%,
      rgba(255, 255, 255, 0.06) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  .page-hero__badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: var(--space-lg);
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .page-hero__sub {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin: 0;
  }

  /* ═══ CONTACT GRID ═══ */
  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-3xl);
    max-width: 64rem;
    margin: 0 auto;
  }

  .contact-form-wrapper h2 {
    margin: 0 0 var(--space-sm);
    font-size: 1.5rem;
  }

  .contact-form__desc {
    color: var(--color-neutral-600);
    margin-bottom: var(--space-xl);
    font-size: 0.9375rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-neutral-700);
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    padding: 0.75rem 1rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    border: 1px solid var(--color-neutral-300);
    border-radius: var(--radius-lg);
    color: var(--color-neutral-900);
    background: var(--color-white);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--color-neutral-400);
  }

  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(0, 96, 175, 0.1);
  }

  /* ═══ SIDEBAR ═══ */
  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .contact-info-card {
    padding: var(--space-xl);
    background: var(--color-white);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-xl);
  }

  .contact-info-card h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-lg);
  }

  .channel-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .channel-item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--color-neutral-50);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
    text-decoration: none;
    color: inherit;
  }

  .channel-item:hover {
    background: var(--color-primary-light);
    color: inherit;
  }

  .channel-item__icon {
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .channel-item:hover .channel-item__icon {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .channel-item__label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-neutral-500);
  }

  .channel-item__value {
    display: block;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-neutral-900);
    margin-top: 0.125rem;
  }

  .response-card {
    padding: var(--space-xl);
    background: var(--color-primary-50);
    border: 1px solid var(--color-primary-light);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .response-card__icon {
    width: 3rem;
    height: 3rem;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-md);
  }

  .response-card h4 {
    font-size: 1rem;
    margin-bottom: var(--space-xs);
    color: var(--color-neutral-900);
  }

  .response-card p {
    font-size: 0.875rem;
    color: var(--color-neutral-600);
    line-height: 1.6;
    margin: 0;
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 768px) {
    .page-hero {
      padding: calc(4rem + var(--space-2xl)) 0 var(--space-2xl);
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .form-row {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>

<script>
  import "../scripts/contact-whatshapp";
</script>
