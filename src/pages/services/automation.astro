---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import ServiceSidebar from '../../components/ServiceSidebar.astro';
---

<BaseLayout title="Business AI Automation" description="Streamline operations with AI—reduce manual work and free your team for higher-value tasks." noPadding>
  <section class="svc-hero">
    <div class="svc-hero__bg"></div>
    <div class="container svc-hero__inner">
      <a href="/services" class="svc-hero__back" data-i18n="servicedetail.back">&larr; All Services</a>
      <div class="svc-hero__icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
      </div>
      <h1 data-i18n="service.ai.title">Business AI Automation</h1>
      <p class="svc-hero__sub" data-i18n="service.ai.sub">AI-powered workflows. Less manual work. More focus on what matters.</p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <div class="service-layout">
        <!-- Left -->
        <div class="service-main">
          <ServiceDetail
            title="Business AI Automation"
            i18nPrefix="service.ai"
            problem="Manual, repetitive processes drain time and introduce errors. Data entry, report generation, cross-system synchronization—these tasks consume hours that could be spent on strategy, customer relationships, or innovation."
            approach="We map your current workflows, identify automation opportunities, and design solutions that integrate with your existing tools. We prioritize high-impact, low-risk automations first—delivering quick wins while building toward broader transformation."
            outcome="Reduced manual effort, fewer errors, and faster execution. Your team spends less time on routine tasks and more on work that drives growth."
            useCase="A logistics company was manually syncing orders between their ERP and shipping carriers. We built an automation layer that syncs in real-time, handles edge cases, and sends alerts—cutting 4 hours of daily manual work to near zero."
          />

        </div>
        <!-- Right -->
         <ServiceSidebar/>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .svc-hero {
    position: relative;
    padding: calc(4rem + var(--space-3xl)) 0 var(--space-3xl);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 60%, var(--color-primary-darker) 100%);
    overflow: hidden;
  }
  .svc-hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 70% 30%, rgba(255,255,255,0.06) 0%, transparent 60%);
    pointer-events: none;
  }
  .svc-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }
  .svc-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255,255,255,0.7);
    margin-bottom: var(--space-xl);
    transition: color var(--transition-fast);
  }
  .svc-hero__back:hover {
    color: var(--color-white);
  }
  .svc-hero__icon {
    width: 3.5rem;
    height: 3.5rem;
    background: rgba(255,255,255,0.15);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    margin-bottom: var(--space-lg);
  }
  .svc-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }
  .svc-hero__sub {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.7;
    margin: 0;
  }
  @media (max-width: 768px) {
    .svc-hero {
      padding: calc(4rem + var(--space-2xl)) 0 var(--space-2xl);
    }
  }
  .service-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 40px;
  }
</style>
