---
import BaseLayout from '../../layouts/BaseLayout.astro';

const services = [
  {
    slug: 'web-development',
    title: 'Web Development',
    summary: 'Custom web applications built with modern frameworks for performance and scalability.',
    i18nTitle: 'services.webdev.title',
    i18nSummary: 'services.webdev.summary',
    icon: 'webdev',
  },
  {
    slug: 'mobile-development',
    title: 'Mobile Development',
    summary: 'Custom mobile applications built with clean architecture—scalable, maintainable, and fit for purpose.',
    i18nTitle: 'services.mobile.title',
    i18nSummary: 'services.mobile.summary',
    icon: 'mobile',
  },
  {
    slug: 'web-app-development',
    title: 'Web App Development',
    summary: 'Custom web applications built with clean architecture—scalable, maintainable, and fit for purpose.',
    i18nTitle: 'services.webapp.title',
    i18nSummary: 'services.webapp.summary',
    icon: 'webapp',
  },

  {
    slug: 'development',
    title: 'Software Development',
    summary: 'Custom software built with clean architecture—scalable, maintainable, and fit for purpose.',
    i18nTitle: 'services.dev.title',
    i18nSummary: 'services.dev.summary',
    icon: 'code',
  },
  {
    slug: 'hardware',
    title: 'Hardware Installation',
    summary: 'Professional setup of network infrastructure, servers, workstations, and IT equipment.',
    i18nTitle: 'services.hw.title',
    i18nSummary: 'services.hw.summary',
    icon: 'monitor',
  },
  {
    slug: 'consulting',
    title: 'IT Consulting',
    summary: 'Technology roadmap, architecture review, and strategic alignment for your business goals.',
    i18nTitle: 'services.it.title',
    i18nSummary: 'services.it.summary',
    icon: 'edit',
  },
  {
    slug: 'automation',
    title: 'Business AI Automation',
    summary: 'AI-powered workflows to streamline operations and free your team for higher-value tasks.',
    i18nTitle: 'services.ai.title',
    i18nSummary: 'services.ai.summary',
    icon: 'layers',
  },
  {
    slug: 'audit',
    title: 'Technology Audit',
    summary: 'Objective assessment of your current stack, security posture, and optimization opportunities.',
    i18nTitle: 'services.audit.title',
    i18nSummary: 'services.audit.summary',
    icon: 'check',
  },
  {
    slug: 'strategy',
    title: 'IT Strategy & Advisory',
    summary: 'Technology roadmap, architecture review, and strategic alignment for your business goals.',
    i18nTitle: 'services.strategy.title',
    i18nSummary: 'services.strategy.summary',
    icon: 'globe',
  },
];

const icons: Record<string, string> = {
  code: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
  monitor: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>',
  edit: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>',
  layers: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>',
  check: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>',
  globe: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>',
  webdev: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><line x1="4" y1="10" x2="20" y2="10"/></svg>',
  mobile: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="2" width="14" height="20" rx="2"/><circle cx="12" cy="16" r="1"/></svg>',
  webapp: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="7" y="2" width="10" height="20" rx="2"/><line x1="12" y1="18" x2="12" y2="18.01"/></svg>',
};
---

<BaseLayout title="Services" description="IT Strategy, System Development, Process Automation, Technology Audit. Strategic IT consulting for growing businesses." noPadding>

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero__bg"></div>
    <div class="container page-hero__inner">
      <span class="page-hero__badge" data-aos="fade-up" data-i18n="services.hero.badge">What We Do</span>
      <h1 data-aos="fade-up" data-i18n="services.hero.title">Our Services</h1>
      <p class="page-hero__sub" data-aos="fade-up" data-i18n="services.hero.sub">Strategic IT solutions tailored to your business needs. From software development to AI automation, we deliver end-to-end technology services.</p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="section">
    <div class="container">
      <div class="services-grid">
        {services.map((service, i) => (
          <a href={`/services/${service.slug}`} class="service-card" data-aos="fade-up" data-aos-delay={i * 50}>
            <div class="service-card__icon" set:html={icons[service.icon]} />
            <h2 class="service-card__title" data-i18n={service.i18nTitle}>{service.title}</h2>
            <p class="service-card__text" data-i18n={service.i18nSummary}>{service.summary}</p>
            <span class="service-card__link" data-i18n="services.viewdetails">View details &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Overview -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section__label" data-i18n="services.process.label">Our Process</span>
        <h2 class="section__title" data-i18n="services.process.title">How every engagement works</h2>
        <p class="section__subtitle" data-i18n="services.process.subtitle">Regardless of the service, our structured process ensures consistent, high-quality outcomes.</p>
      </div>
      <div class="process-row">
        <div class="process-item" data-aos="fade-up">
          <div class="process-item__number">1</div>
          <h3 data-i18n="services.process.step1.title">Discovery</h3>
          <p data-i18n="services.process.step1.text">We learn your business, goals, and constraints before proposing anything.</p>
        </div>
        <div class="process-item" data-aos="fade-up" data-aos-delay="100">
          <div class="process-item__number">2</div>
          <h3 data-i18n="services.process.step2.title">Plan</h3>
          <p data-i18n="services.process.step2.text">Clear scope, milestones, and timeline agreed before any work begins.</p>
        </div>
        <div class="process-item" data-aos="fade-up" data-aos-delay="200">
          <div class="process-item__number">3</div>
          <h3 data-i18n="services.process.step3.title">Execute</h3>
          <p data-i18n="services.process.step3.text">Transparent delivery with regular check-ins and progress reports.</p>
        </div>
        <div class="process-item" data-aos="fade-up" data-aos-delay="300">
          <div class="process-item__number">4</div>
          <h3 data-i18n="services.process.step4.title">Handover</h3>
          <p data-i18n="services.process.step4.text">Documentation, training, and knowledge transfer included in every engagement.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="services-cta">
    <div class="services-cta__bg"></div>
    <div class="container services-cta__inner" data-aos="fade-up">
      <h2 data-i18n="services.cta.title">Ready to discuss your project?</h2>
      <p data-i18n="services.cta.text">Every engagement starts with a conversation. Let's find the right solution for your business.</p>
      <a href="/contact" class="btn btn--white btn--large" data-i18n="services.cta.btn">Schedule a Consultation</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ═══ PAGE HERO ═══ */
  .page-hero {
    position: relative;
    padding: calc(4rem + var(--space-3xl)) 0 var(--space-3xl);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 60%, var(--color-primary-darker) 100%);
    overflow: hidden;
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 70% 30%, rgba(255,255,255,0.06) 0%, transparent 60%);
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  .page-hero__badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255,255,255,0.9);
    margin-bottom: var(--space-lg);
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .page-hero__sub {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.7;
    margin: 0;
  }

  /* ═══ SERVICES GRID ═══ */
  .section-header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .service-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-xl);
    background: var(--color-white);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-xl);
    transition: all var(--transition-base);
    text-decoration: none;
    color: inherit;
  }

  .service-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    color: inherit;
  }

  .service-card__icon {
    width: 3.5rem;
    height: 3.5rem;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-lg);
    transition: all var(--transition-base);
  }

  .service-card:hover .service-card__icon {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .service-card__title {
    font-size: 1.125rem;
    margin-bottom: var(--space-sm);
    color: var(--color-neutral-900);
  }

  .service-card__text {
    font-size: 0.9375rem;
    color: var(--color-neutral-600);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
    flex: 1;
  }

  .service-card__link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  /* ═══ PROCESS ═══ */
  .process-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xl);
  }

  .process-item {
    text-align: center;
  }

  .process-item__number {
    width: 3rem;
    height: 3rem;
    background: var(--color-primary);
    color: var(--color-white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0 auto var(--space-md);
  }

  .process-item h3 {
    font-size: 1rem;
    margin-bottom: var(--space-sm);
    color: var(--color-neutral-900);
  }

  .process-item p {
    font-size: 0.875rem;
    color: var(--color-neutral-600);
    line-height: 1.6;
    margin: 0;
  }

  /* ═══ CTA ═══ */
  .services-cta {
    position: relative;
    padding: var(--space-5xl) 0;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 50%, var(--color-primary-darker) 100%);
    overflow: hidden;
  }

  .services-cta__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 60% at 30% 50%, rgba(255,255,255,0.06) 0%, transparent 60%);
    pointer-events: none;
  }

  .services-cta__inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .services-cta__inner h2 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .services-cta__inner p {
    color: rgba(255,255,255,0.8);
    font-size: 1.125rem;
    max-width: 32rem;
    margin: 0 auto var(--space-xl);
    line-height: 1.7;
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-row {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-xl);
    }
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: calc(4rem + var(--space-2xl)) 0 var(--space-2xl);
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .process-row {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .services-cta {
      padding: var(--space-3xl) 0;
    }
  }
</style>
