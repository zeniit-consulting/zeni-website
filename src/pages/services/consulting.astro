---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
---

<BaseLayout title="IT Consulting" description="Technology roadmap, architecture review, and strategic alignment for your business goals." noPadding>
  <section class="svc-hero">
    <div class="svc-hero__bg"></div>
    <div class="container svc-hero__inner">
      <a href="/services" class="svc-hero__back" data-i18n="servicedetail.back">&larr; All Services</a>
      <div class="svc-hero__icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
      </div>
      <h1 data-i18n="service.it.title">IT Consulting</h1>
      <p class="svc-hero__sub" data-i18n="service.it.sub">Align technology with business objectives. Make informed decisions.</p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <ServiceDetail
        title="IT Consulting"
        i18nPrefix="service.it"
        problem="Growing businesses often face unclear technology direction—sprawling systems, conflicting priorities, or decisions driven by vendors rather than strategy. The result: wasted spend, technical debt, and missed opportunities."
        approach="We conduct structured discovery to understand your business goals, current state, and constraints. We then develop a practical roadmap—prioritized, phased, and aligned with your growth trajectory. No jargon-heavy reports; we deliver actionable recommendations you can implement."
        outcome="Clear technology direction, validated architecture decisions, and a roadmap that your team and stakeholders can execute. You'll know what to build, why, and in what order."
        useCase="A mid-size retailer needed to consolidate five legacy systems into a unified platform. We delivered an 18-month migration roadmap with clear phases, cost projections, and risk mitigation—enabling informed board-level decisions."
      />
    </div>
  </section>
</BaseLayout>

<style>
  .svc-hero {
    position: relative;
    padding: calc(4rem + var(--space-3xl)) 0 var(--space-3xl);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 60%, var(--color-primary-darker) 100%);
    overflow: hidden;
  }
  .svc-hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 70% 30%, rgba(255,255,255,0.06) 0%, transparent 60%);
    pointer-events: none;
  }
  .svc-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }
  .svc-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255,255,255,0.7);
    margin-bottom: var(--space-xl);
    transition: color var(--transition-fast);
  }
  .svc-hero__back:hover {
    color: var(--color-white);
  }
  .svc-hero__icon {
    width: 3.5rem;
    height: 3.5rem;
    background: rgba(255,255,255,0.15);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    margin-bottom: var(--space-lg);
  }
  .svc-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }
  .svc-hero__sub {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.7;
    margin: 0;
  }
  @media (max-width: 768px) {
    .svc-hero {
      padding: calc(4rem + var(--space-2xl)) 0 var(--space-2xl);
    }
  }
</style>
