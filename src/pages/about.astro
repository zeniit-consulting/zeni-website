---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="Philosophy, approach, and engagement model. Zeni Consulting is an advisory firm focused on strategic IT." noPadding>

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero__bg"></div>
    <div class="container page-hero__inner">
      <span class="page-hero__badge" data-aos="fade-up" data-i18n="about.hero.badge">About Us</span>
      <h1 data-aos="fade-up" data-i18n="about.hero.title">About Zeni</h1>
      <p class="page-hero__sub" data-aos="fade-up" data-i18n="about.hero.sub">Strategic advisory. Not just another agency. We bring clarity to complex technical decisions and deliver outcomes that matter.</p>
    </div>
  </section>

  <!-- Philosophy Section -->
  <section class="section">
    <div class="container">
      <div class="split-section">
        <div class="split-section__content" data-aos="fade-right">
          <span class="section__label" data-i18n="about.philosophy.label">Our Philosophy</span>
          <h2 data-i18n="about.philosophy.title">Technology should serve business—not the reverse</h2>
          <p data-i18n="about.philosophy.text">We believe technology should serve business—not the reverse. Our role is to bring clarity to complex technical decisions, align systems with strategy, and deliver outcomes that matter. We don't chase trends. We build foundations that last.</p>
        </div>
        <div class="split-section__visual" data-aos="fade-left">
          <div class="value-cards">
            <div class="value-card">
              <div class="value-card__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <div>
                <strong data-i18n="about.value.trust.title">Trust & Transparency</strong>
                <span data-i18n="about.value.trust.text">Clear communication at every step</span>
              </div>
            </div>
            <div class="value-card">
              <div class="value-card__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
              </div>
              <div>
                <strong data-i18n="about.value.impact.title">Business Impact</strong>
                <span data-i18n="about.value.impact.text">Results that move the needle</span>
              </div>
            </div>
            <div class="value-card">
              <div class="value-card__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              </div>
              <div>
                <strong data-i18n="about.value.quality.title">Quality First</strong>
                <span data-i18n="about.value.quality.text">No shortcuts, no compromises</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How We Work -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section__label" data-i18n="about.howwework.label">Our Approach</span>
        <h2 class="section__title" data-i18n="about.howwework.title">How We Work</h2>
        <p class="section__subtitle" data-i18n="about.howwework.text">We start with understanding. Before proposing any solution, we invest time in learning your business, your goals, and your constraints.</p>
      </div>
      <div class="approach-grid">
        <div class="approach-card" data-aos="fade-up">
          <div class="approach-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>
          <h3 data-i18n="about.approach.1">Discovery first—no assumptions</h3>
          <p data-i18n="about.approach.1.detail">We ask the right questions and listen before proposing any solution.</p>
        </div>
        <div class="approach-card" data-aos="fade-up" data-aos-delay="50">
          <div class="approach-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          </div>
          <h3 data-i18n="about.approach.2">Transparent communication</h3>
          <p data-i18n="about.approach.2.detail">Clear milestones, regular updates, and honest feedback at every stage.</p>
        </div>
        <div class="approach-card" data-aos="fade-up" data-aos-delay="100">
          <div class="approach-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
          <h3 data-i18n="about.approach.3">Documentation & knowledge transfer</h3>
          <p data-i18n="about.approach.3.detail">Everything we build comes with complete documentation and training.</p>
        </div>
        <div class="approach-card" data-aos="fade-up" data-aos-delay="150">
          <div class="approach-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          </div>
          <h3 data-i18n="about.approach.4">Ongoing support & iteration</h3>
          <p data-i18n="about.approach.4.detail">We stay available for continuous improvement and long-term partnership.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Engagement Models -->
  <section class="section">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section__label" data-i18n="about.engagement.label">Work With Us</span>
        <h2 class="section__title" data-i18n="about.engagement.title">Engagement Model</h2>
        <p class="section__subtitle" data-i18n="about.engagement.text">Flexible engagement options tailored to your needs. Every engagement begins with a clear scope, timeline, and success criteria.</p>
      </div>
      <div class="engagement-grid">
        <div class="engagement-card" data-aos="fade-up">
          <div class="engagement-card__badge">01</div>
          <h3 data-i18n="about.engagement.project.title">Project-Based</h3>
          <p data-i18n="about.engagement.project.text">Fixed scope, fixed timeline. Ideal for system development, audits, or strategic assessments.</p>
          <ul class="engagement-card__list">
            <li data-i18n="about.engagement.project.f1">Defined deliverables</li>
            <li data-i18n="about.engagement.project.f2">Clear milestones</li>
            <li data-i18n="about.engagement.project.f3">Complete handover</li>
          </ul>
        </div>
        <div class="engagement-card engagement-card--featured" data-aos="fade-up" data-aos-delay="100">
          <div class="engagement-card__badge">02</div>
          <h3 data-i18n="about.engagement.retainer.title">Retainer</h3>
          <p data-i18n="about.engagement.retainer.text">Ongoing strategic support, maintenance, and advisory. For long-term technology leadership.</p>
          <ul class="engagement-card__list">
            <li data-i18n="about.engagement.retainer.f1">Dedicated hours</li>
            <li data-i18n="about.engagement.retainer.f2">Priority support</li>
            <li data-i18n="about.engagement.retainer.f3">Strategic planning</li>
          </ul>
        </div>
        <div class="engagement-card" data-aos="fade-up" data-aos-delay="200">
          <div class="engagement-card__badge">03</div>
          <h3 data-i18n="about.engagement.consult.title">Consultation</h3>
          <p data-i18n="about.engagement.consult.text">One-off sessions for architecture review, technology selection, or strategy alignment.</p>
          <ul class="engagement-card__list">
            <li data-i18n="about.engagement.consult.f1">Expert advice</li>
            <li data-i18n="about.engagement.consult.f2">Written recommendations</li>
            <li data-i18n="about.engagement.consult.f3">Follow-up support</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership -->
  <section class="section section--alt">
    <div class="container">
      <div class="split-section split-section--reverse">
        <div class="split-section__content" data-aos="fade-left">
          <span class="section__label" data-i18n="about.leadership.label">Leadership</span>
          <h2 data-i18n="about.leadership.title">Led by practitioners</h2>
          <p data-i18n="about.leadership.text">Zeni Consulting is led by practitioners with deep experience in enterprise systems, startups, and digital transformation. We combine technical depth with business acumen—we speak both languages.</p>
          <div class="leadership-cta">
            <p data-i18n="about.leadership.cta.text">Ready to discuss how we can support your technology strategy?</p>
            <a href="/contact" class="btn btn--primary" data-i18n="about.leadership.cta.btn">Get in Touch</a>
          </div>
        </div>
        <div class="split-section__visual" data-aos="fade-right">
          <div class="leadership-stats">
            <div class="leadership-stat">
              <span class="leadership-stat__value">10+</span>
              <span class="leadership-stat__label" data-i18n="about.leadership.stat1">Years in IT</span>
            </div>
            <div class="leadership-stat">
              <span class="leadership-stat__value">50+</span>
              <span class="leadership-stat__label" data-i18n="about.leadership.stat2">Projects</span>
            </div>
            <div class="leadership-stat">
              <span class="leadership-stat__value">5+</span>
              <span class="leadership-stat__label" data-i18n="about.leadership.stat3">Industries</span>
            </div>
            <div class="leadership-stat">
              <span class="leadership-stat__value">100%</span>
              <span class="leadership-stat__label" data-i18n="about.leadership.stat4">Commitment</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta">
    <div class="about-cta__bg"></div>
    <div class="container about-cta__inner" data-aos="fade-up">
      <h2 data-i18n="about.cta.title">Let's build something great together</h2>
      <p data-i18n="about.cta.text">Start a conversation about how Zeni can support your technology goals.</p>
      <div class="about-cta__buttons">
        <a href="/contact" class="btn btn--white btn--large" data-i18n="about.cta.btn1">Book Free Consultation</a>
        <a href="/services" class="btn btn--ghost btn--large" data-i18n="about.cta.btn2">View Services</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ═══ PAGE HERO ═══ */
  .page-hero {
    position: relative;
    padding: calc(4rem + var(--space-3xl)) 0 var(--space-3xl);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 60%, var(--color-primary-darker) 100%);
    overflow: hidden;
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 70% 30%, rgba(255,255,255,0.06) 0%, transparent 60%);
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  .page-hero__badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255,255,255,0.9);
    margin-bottom: var(--space-lg);
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .page-hero__sub {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.7;
    margin: 0;
  }

  /* ═══ SPLIT SECTION ═══ */
  .split-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    align-items: center;
  }

  .split-section--reverse {
    direction: rtl;
  }

  .split-section--reverse > * {
    direction: ltr;
  }

  .split-section__content h2 {
    margin-bottom: var(--space-lg);
  }

  .split-section__content p {
    color: var(--color-neutral-600);
    line-height: 1.7;
    font-size: 1rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  /* ═══ VALUE CARDS ═══ */
  .value-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .value-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--color-white);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-xl);
    transition: all var(--transition-base);
  }

  .value-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .value-card__icon {
    width: 3rem;
    height: 3rem;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .value-card strong {
    display: block;
    font-size: 0.9375rem;
    color: var(--color-neutral-900);
    margin-bottom: 0.125rem;
  }

  .value-card span {
    font-size: 0.8125rem;
    color: var(--color-neutral-500);
  }

  /* ═══ APPROACH GRID ═══ */
  .approach-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .approach-card {
    padding: var(--space-xl);
    background: var(--color-white);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-xl);
    transition: all var(--transition-base);
  }

  .approach-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .approach-card__icon {
    width: 3rem;
    height: 3rem;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-md);
  }

  .approach-card h3 {
    font-size: 1rem;
    margin-bottom: var(--space-sm);
    color: var(--color-neutral-900);
  }

  .approach-card p {
    font-size: 0.9375rem;
    color: var(--color-neutral-600);
    line-height: 1.6;
    margin: 0;
  }

  /* ═══ ENGAGEMENT GRID ═══ */
  .engagement-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .engagement-card {
    padding: var(--space-xl);
    background: var(--color-white);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-xl);
    transition: all var(--transition-base);
    position: relative;
  }

  .engagement-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .engagement-card--featured {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px var(--color-primary);
  }

  .engagement-card__badge {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary-light);
    margin-bottom: var(--space-md);
    line-height: 1;
  }

  .engagement-card--featured .engagement-card__badge {
    color: var(--color-primary);
  }

  .engagement-card h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-sm);
    color: var(--color-neutral-900);
  }

  .engagement-card > p {
    font-size: 0.9375rem;
    color: var(--color-neutral-600);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
  }

  .engagement-card__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-neutral-100);
    padding-top: var(--space-md);
  }

  .engagement-card__list li {
    font-size: 0.875rem;
    color: var(--color-neutral-600);
    padding: var(--space-xs) 0;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .engagement-card__list li::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--color-primary);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ═══ LEADERSHIP ═══ */
  .leadership-cta {
    margin-top: var(--space-xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-neutral-200);
  }

  .leadership-cta p {
    font-style: italic;
    margin-bottom: var(--space-lg);
  }

  .leadership-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .leadership-stat {
    padding: var(--space-xl);
    background: var(--color-white);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .leadership-stat__value {
    display: block;
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: var(--space-sm);
  }

  .leadership-stat__label {
    font-size: 0.8125rem;
    color: var(--color-neutral-500);
    font-weight: 500;
  }

  /* ═══ ABOUT CTA ═══ */
  .about-cta {
    position: relative;
    padding: var(--space-5xl) 0;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 50%, var(--color-primary-darker) 100%);
    overflow: hidden;
  }

  .about-cta__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 60% at 30% 50%, rgba(255,255,255,0.06) 0%, transparent 60%),
      radial-gradient(ellipse 40% 40% at 80% 20%, rgba(0,168,232,0.1) 0%, transparent 60%);
    pointer-events: none;
  }

  .about-cta__inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .about-cta__inner h2 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .about-cta__inner p {
    color: rgba(255,255,255,0.8);
    font-size: 1.125rem;
    max-width: 32rem;
    margin: 0 auto var(--space-xl);
    line-height: 1.7;
  }

  .about-cta__buttons {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 768px) {
    .page-hero {
      padding: calc(4rem + var(--space-2xl)) 0 var(--space-2xl);
    }

    .split-section {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .split-section--reverse {
      direction: ltr;
    }

    .approach-grid {
      grid-template-columns: 1fr;
    }

    .engagement-grid {
      grid-template-columns: 1fr;
    }

    .leadership-stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .about-cta {
      padding: var(--space-3xl) 0;
    }

    .about-cta__buttons {
      flex-direction: column;
      align-items: center;
    }

    .about-cta__buttons .btn {
      width: 100%;
      max-width: 20rem;
    }
  }
</style>
