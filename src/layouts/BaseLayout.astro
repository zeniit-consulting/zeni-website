    <script>
      import { getLang, setLang, applyTranslations, type Lang } from '../scripts/i18n';
      document.addEventListener('DOMContentLoaded', () => {
        // AOS
        const initAOS = () => {
          import('aos')
            .then(({ default: AOS }) => AOS.init({ duration: 600, once: true, offset: 50 }))
            .catch(() => {});
        };
        const win = window as Window & { requestIdleCallback?: (cb: IdleRequestCallback) => number };
        if (typeof win.requestIdleCallback === 'function') win.requestIdleCallback(initAOS);
        else win.addEventListener('load', initAOS);

        // i18n
        const savedLang = getLang();
        const langCurrent = document.getElementById('lang-current');
        if (langCurrent) langCurrent.textContent = savedLang.toUpperCase();
        document.querySelectorAll('.lang-option').forEach(b => {
          b.classList.toggle('lang-option--active', b.getAttribute('data-lang') === savedLang);
        });
        applyTranslations(savedLang);

        // Mega menu toggle
        const trigger = document.getElementById('services-trigger');
        const mega = document.getElementById('services-mega');
        if (trigger && mega) {
          trigger.addEventListener('click', (e) => {
            e.preventDefault();
            const open = mega.getAttribute('aria-hidden') === 'false';
            mega.setAttribute('aria-hidden', open ? 'true' : 'false');
            mega.classList.toggle('header__mega--open', !open);
            trigger.classList.toggle('header__dropdown-trigger--active', !open);
          });
        }

        // Hamburger
        const hamburger = document.getElementById('hamburger-btn');
        const nav = document.getElementById('main-nav');
        const overlay = document.getElementById('mobile-overlay');
        if (hamburger && nav && overlay) {
          const toggleMenu = () => {
            const isOpen = nav.classList.contains('header__nav--open');
            nav.classList.toggle('header__nav--open', !isOpen);
            hamburger.classList.toggle('header__hamburger--active', !isOpen);
            overlay.classList.toggle('mobile-overlay--active', !isOpen);
            document.body.style.overflow = isOpen ? '' : 'hidden';
          };
          hamburger.addEventListener('click', toggleMenu);
          overlay.addEventListener('click', toggleMenu);
          nav.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
              if (nav.classList.contains('header__nav--open')) toggleMenu();
            });
          });
        }

        // Language selector
        const langTrigger = document.getElementById('lang-trigger');
        const langMenu = document.getElementById('lang-menu');
        if (langTrigger && langMenu && langCurrent) {
          langTrigger.addEventListener('click', () => {
            const open = langMenu.getAttribute('aria-hidden') === 'false';
            langMenu.setAttribute('aria-hidden', open ? 'true' : 'false');
            langMenu.classList.toggle('lang-selector__menu--open', !open);
          });
          langMenu.querySelectorAll('.lang-option').forEach(btn => {
            btn.addEventListener('click', () => {
              const lang = (btn.getAttribute('data-lang') || 'id') as Lang;
              langCurrent.textContent = lang.toUpperCase();
              setLang(lang);
              applyTranslations(lang);
              langMenu.querySelectorAll('.lang-option').forEach(b => b.classList.remove('lang-option--active'));
              btn.classList.add('lang-option--active');
              langMenu.setAttribute('aria-hidden', 'true');
              langMenu.classList.remove('lang-selector__menu--open');
            });
          });
          document.addEventListener('click', (e) => {
            const target = e.target as Node | null;
            if (target && !langTrigger.contains(target) && !langMenu.contains(target)) {
              langMenu.setAttribute('aria-hidden', 'true');
              langMenu.classList.remove('lang-selector__menu--open');
            }
          });
        }

        // Header scroll effect
        const header = document.getElementById('site-header');
        if (header) {
          let lastScroll = 0;
          window.addEventListener('scroll', () => {
            const currentScroll = window.scrollY;
            header.classList.toggle('header--scrolled', currentScroll > 20);
            lastScroll = currentScroll;
          }, { passive: true });
        }
      });
    </script>
  </body>
