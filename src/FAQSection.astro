---
const faqs = [
  {
    question: "Apa itu Zeni Consulting?",
    answer:
      "Zeni Consulting adalah partner teknologi yang membantu bisnis membangun sistem digital, automasi, dan solusi IT yang scalable.",
  },
  {
    question: "Layanan apa saja yang ditawarkan Zeni Consulting?",
    answer:
      "Kami menyediakan layanan pengembangan software, instalasi perangkat keras, konsultasi IT, automasi AI bisnis, dan sistem operasional digital.",
  },
  {
    question: "Apakah Zeni Consulting bisa membantu bisnis logistik?",
    answer:
      "Ya, kami dapat membantu bisnis logistik membangun dashboard operasional, tracking pengiriman, workflow automation, dan reporting system.",
  },
  {
    question: "Apakah solusi bisa disesuaikan dengan kebutuhan bisnis?",
    answer:
      "Bisa. Setiap solusi dapat disesuaikan dengan proses bisnis, kebutuhan tim, dan target operasional perusahaan.",
  },
  {
    question: "Bagaimana cara mulai konsultasi dengan Zeni Consulting?",
    answer:
      "Anda dapat menghubungi kami melalui WhatsApp atau halaman kontak untuk mendiskusikan kebutuhan bisnis Anda.",
  },
];
---

<section class="faq-section">
  <div class="container">
    <div class="faq-header">
      <span>FAQ</span>
      <h2>Pertanyaan seputar Zeni Consulting</h2>
    </div>

    <div class="faq-list">
      {
        faqs.map((faq) => (
          <details class="faq-item">
            <summary>
              <span>{faq.question}</span>
            </summary>

            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding: 6rem 0;
    background: #ffffff;
  }

  .faq-header {
    margin-bottom: 2rem;
  }

  .faq-header span {
    display: inline-block;
    margin-bottom: 0.75rem;
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .faq-header h2 {
    max-width: 680px;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    color: var(--color-neutral-900);
  }

  .faq-list {
    max-width: 980px;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-neutral-200);
  }

  .faq-item summary {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 0;
    cursor: pointer;
    list-style: none;
    color: var(--color-neutral-900);
    font-weight: 700;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::before {
    content: "";
    width: 0;
    height: 0;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    border-left: 8px solid var(--color-neutral-500);
    transition: transform 0.25s ease;
  }

  .faq-item[open] summary::before {
    transform: rotate(90deg);
  }

  .faq-answer {
    padding: 0 0 1.5rem 2rem;
  }

  .faq-answer p {
    max-width: 760px;
    margin: 0;
    color: var(--color-neutral-600);
    line-height: 1.8;
  }

  @media (max-width: 640px) {
    .faq-section {
      padding: 4rem 0;
    }

    .faq-item summary {
      align-items: flex-start;
      padding: 1.25rem 0;
      font-size: 0.95rem;
    }

    .faq-answer {
      padding-left: 1.75rem;
    }
  }
</style>